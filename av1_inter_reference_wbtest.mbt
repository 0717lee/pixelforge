test "inter_warped_64x64: warped-motion inter frame reconstructs" {
  let (seq, headers, map) = av1_inter_parse(
    inter_warped_64x64_obu, "inter_warped_64x64",
  )
  let key = headers[0]
  assert_eq(key.frame_is_intra, true)
  let inter = headers[1]
  assert_eq(inter.frame_is_intra, false)
  // --enable-warped-motion=1 sets the sequence flag, so the frame header
  // derives allow_warped_motion and read_motion_mode can take its three-symbol
  // branch. is_motion_mode_switchable comes from the same flag pair.
  assert_eq(seq.enable_warped_motion, true)
  assert_eq(inter.allow_warped_motion, true)
  assert_eq(inter.is_motion_mode_switchable, true)
  assert_eq(av1_inter_frame_supported(inter, seq), true)
  // Parsing alone must not touch the buffer: only reconstruction stores.
  assert_eq(av1_frame_map_show(map, 0) is None, true)
  let map2 = av1_frame_map()
  let whole = inter_warped_64x64_obu
  let key_unit = av1_inter_slice_bytes(whole, 0, 48)
  let inter_unit = av1_inter_slice_bytes(whole, 48, 73)
  let sequence = match av1_sequence_info(key_unit) {
    Some(value) => value
    None => fail("inter_warped_64x64: no sequence header")
  }
  if av1_decode_frame_planes(key_unit, map=map2) is None {
    fail("inter_warped_64x64: key frame decode rejected")
  }
  let frame = match av1_decode_frame_planes(inter_unit, map=map2, sequence~) {
    Some(value) => value
    None => fail("inter_warped_64x64: supported inter frame rejected")
  }
  let reference = av1_inter_expand(inter_warped_64x64_frame1_reference)
  let chroma = 6144 / 6
  let luma_size = 6144 - chroma * 2
  let bad = [0, 0, 0]
  for p in 0..<3 {
    let got = av1_frame_crop(frame, p)
    let start = if p == 0 {
      0
    } else if p == 1 {
      luma_size
    } else {
      luma_size + chroma
    }
    for i in 0..<got.length() {
      if got[i] != reference[start + i] {
        bad[p] = bad[p] + 1
      }
    }
  }
  assert_eq(bad, [0, 0, 0])
}

///|
test "inter_warped_64x64: the key frame matches dav1d" {
  let map = av1_frame_map()
  let key_unit = av1_inter_slice_bytes(inter_warped_64x64_obu, 0, 48)
  let decoded = match av1_decode_frame_planes(key_unit, map~) {
    Some(value) => value
    None => fail("inter_warped_64x64: key frame decode rejected")
  }
  let reference = av1_inter_expand(inter_warped_64x64_frame0_reference)
  let chroma = 6144 / 6
  let luma_size = 6144 - chroma * 2
  let bad = [0, 0, 0]
  for p in 0..<3 {
    let got = av1_frame_crop(decoded, p)
    let start = if p == 0 {
      0
    } else if p == 1 {
      luma_size
    } else {
      luma_size + chroma
    }
    for i in 0..<got.length() {
      if got[i] != reference[start + i] {
        bad[p] = bad[p] + 1
      }
    }
  }
  assert_eq(bad, [0, 0, 0])
}

