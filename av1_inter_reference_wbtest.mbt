///|
test "inter_palette_64x64: palette inside an inter frame reconstructs" {
  let (seq, headers, map) = av1_inter_parse(
    inter_palette_64x64_obu, "inter_palette_64x64",
  )
  let key = headers[0]
  assert_eq(key.frame_is_intra, true)
  let inter = headers[1]
  assert_eq(inter.frame_is_intra, false)
  // The whole point of this fixture: the inter frame signals screen-content
  // tools, so its intra blocks may read palette syntax.
  assert_eq(inter.allow_screen_content_tools, true)
  assert_eq(seq.enable_warped_motion, false)
  assert_eq(av1_inter_frame_supported(inter, seq), true)
  // Parsing alone must not touch the buffer: only reconstruction stores.
  assert_eq(av1_frame_map_show(map, 0) is None, true)
  let map2 = av1_frame_map()
  let whole = inter_palette_64x64_obu
  let key_unit = av1_inter_slice_bytes(whole, 0, 48)
  let inter_unit = av1_inter_slice_bytes(whole, 48, 87)
  let sequence = match av1_sequence_info(key_unit) {
    Some(value) => value
    None => fail("inter_palette_64x64: no sequence header")
  }
  if av1_decode_frame_planes(key_unit, map=map2) is None {
    fail("inter_palette_64x64: key frame decode rejected")
  }
  let frame = match av1_decode_frame_planes(inter_unit, map=map2, sequence~) {
    Some(value) => value
    None => fail("inter_palette_64x64: supported inter frame rejected")
  }
  let reference = av1_inter_expand(inter_palette_64x64_frame1_reference)
  let chroma = 6144 / 6
  let luma_size = 6144 - chroma * 2
  let bad = [0, 0, 0]
  for p in 0..<3 {
    let got = av1_frame_crop(frame, p)
    let start = if p == 0 {
      0
    } else if p == 1 {
      luma_size
    } else {
      luma_size + chroma
    }
    for i in 0..<got.length() {
      if got[i] != reference[start + i] {
        bad[p] = bad[p] + 1
      }
    }
  }
  assert_eq(bad, [0, 0, 0])
}

///|
test "inter_palette_64x64: the key frame matches dav1d" {
  let map = av1_frame_map()
  let key_unit = av1_inter_slice_bytes(inter_palette_64x64_obu, 0, 48)
  let decoded = match av1_decode_frame_planes(key_unit, map~) {
    Some(value) => value
    None => fail("inter_palette_64x64: key frame decode rejected")
  }
  let reference = av1_inter_expand(inter_palette_64x64_frame0_reference)
  let chroma = 6144 / 6
  let luma_size = 6144 - chroma * 2
  let bad = [0, 0, 0]
  for p in 0..<3 {
    let got = av1_frame_crop(decoded, p)
    let start = if p == 0 {
      0
    } else if p == 1 {
      luma_size
    } else {
      luma_size + chroma
    }
    for i in 0..<got.length() {
      if got[i] != reference[start + i] {
        bad[p] = bad[p] + 1
      }
    }
  }
  assert_eq(bad, [0, 0, 0])
}

