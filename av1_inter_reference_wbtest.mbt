  assert_eq(key.frame_width, 64)
  assert_eq(key.upscaled_width, 64)
  assert_eq(key.frame_height, 64)
  assert_eq(key.superres_denom, 8)
  assert_eq(key.render_width, 64)
  assert_eq(key.base_q_idx, 49)
  assert_eq(key.header_bytes, 10)

  let inter = headers[1]
  assert_eq(inter.frame_type, av1_inter_frame)
  assert_eq(inter.frame_is_intra, false)
  assert_eq(inter.show_frame, true)
  assert_eq(inter.error_resilient, false)
  assert_eq(inter.order_hint, 0)
  // Most fixtures here code PRIMARY_REF_NONE; the inheritance fixture names a
  // reference instead, so the expected value is part of its spec.
  assert_eq(inter.primary_ref_frame, av1_primary_ref_none)
  assert_eq(inter.refresh_frame_flags, 2)
  assert_eq(inter.base_q_idx, 128)
  assert_eq(inter.header_bytes, 16)
  assert_eq(inter.ref_frame_idx.length(), av1_refs_per_frame)
  for slot in inter.ref_frame_idx {
    // frame_refs_short_signaling is 0 here and every name points at slot 0.
    assert_eq(slot, 0)
  }
  assert_eq(inter.allow_high_precision_mv, false)
  // A switchable frame defers the interpolation filter to each block.
  assert_eq(inter.interpolation_filter, 4)
  assert_eq(inter.allow_warped_motion, false)
  assert_eq(inter.use_ref_frame_mvs, false)
  assert_eq(inter.is_motion_mode_switchable, false)
  assert_eq(inter.reference_select, false)
  assert_eq(inter.skip_mode_present, false)
  assert_eq(inter.allow_intrabc, false)
  for typ in inter.gm_type {
    assert_eq(typ, av1_gm_identity)
  }
  for bias in inter.ref_frame_sign_bias {
    assert_eq(bias, 0)
  }

  // Parsing alone must not touch the buffer: only reconstruction stores.
  assert_eq(av1_frame_map_show(map, 0) is None, true)
  let decoded = match av1_decode_frame_planes(inter_shift_64x64_obu, map~) {
    Some(value) => value
    None => fail("inter_shift_64x64: key frame decode rejected")
  }
  // dav1d's native planes are stored row-packed per plane, the same view
  // `av1_frame_crop` produces from the MI-padded coding layout.
  let reference = av1_inter_expand(inter_shift_64x64_frame0_reference)
  let chroma = 6144 / 6
  assert_eq(
    av1_frame_crop(decoded, 0),
    av1_inter_slice(reference, 0, 6144 - chroma * 2),
  )
  assert_eq(
    av1_frame_crop(decoded, 1),
    av1_inter_slice(reference, 6144 - chroma * 2, 6144 - chroma),
  )
  assert_eq(
    av1_frame_crop(decoded, 2),
    av1_inter_slice(reference, 6144 - chroma, 6144),
  )
  // Every slot a key frame claims now shares the same decoded picture.
  let stored = match av1_frame_map_show(map, 0) {
    Some(value) => value
    None => fail("inter_shift_64x64: key frame not stored")
  }
  assert_eq(stored.upscaled_width, 64)
  assert_eq(stored.frame_height, 64)
  assert_eq(stored.bit_depth, 8)
  assert_eq(stored.frame_type, av1_key_frame)
  for slot in 0..<av1_num_ref_frames {
    assert_eq(av1_frame_map_show(map, slot) is None, false)
  }
}

///|
test "inter_shift_64x64: inter frame reconstruction" {
  let map = av1_frame_map()
  let whole = inter_shift_64x64_obu
  let key_unit = av1_inter_slice_bytes(whole, 0, 82)
  let inter_unit = av1_inter_slice_bytes(whole, 82, 105)
  let sequence = match av1_sequence_info(key_unit) {
    Some(value) => value
    None => fail("inter_shift_64x64: no sequence header")
  }
  if av1_decode_frame_planes(key_unit, map~) is None {
    fail("inter_shift_64x64: key frame decode rejected")
  }
  // fractional translation: subpel motion compensation plus chroma deblocking. A frame that needs a missing tool must be refused whole:
  // a partial reconstruction would be worse than no picture at all.
  let inter = av1_decode_frame_planes(inter_unit, map~, sequence~)
  assert_eq(inter is Some(_), true)
  if true {
    let frame = match inter {
      Some(value) => value
      None => fail("inter_shift_64x64: supported inter frame rejected")
    }
    // dav1d's native planes for the inter frame: sample-exact evidence that
    // motion compensation, the residual and the frame filters agree with an
    // external decoder. Every sample of every plane is counted, so a fixture
    // that is not exact yet carries its disagreement as an explicit number
    // rather than as an excluded region.
    let reference = av1_inter_expand(inter_shift_64x64_frame1_reference)
    let chroma = 6144 / 6
    let luma_size = 6144 - chroma * 2
    let bad = [0, 0, 0]
    for p in 0..<3 {
      let got = av1_frame_crop(frame, p)
      let start = if p == 0 {
        0
      } else if p == 1 {
        luma_size
      } else {
        luma_size + chroma
      }
      for i in 0..<got.length() {
        if got[i] != reference[start + i] {
          bad[p] = bad[p] + 1
        }
      }
    }
    assert_eq(bad, [0, 0, 0])
  }
}

///|
/// The animated-AVIF seam: one stateful decoder walks the temporal units of a
/// sequence, and a later unit may carry neither the sequence header nor a
/// key frame. The second sample is a translated picture, so the presented pixels must differ.
test "inter_shift_64x64: animation entry presents both temporal units" {
  let whole = inter_shift_64x64_obu
  let key_unit = av1_inter_slice_bytes(whole, 0, 82)
  let inter_unit = av1_inter_slice_bytes(whole, 82, 105)
  let samples = avif_decode_animation_samples(1000, [0, 40], [40, 40], [
    key_unit, inter_unit,
  ])
  let sequence = match samples {
    Some(value) => value
    None => fail("inter_shift_64x64: animation sequence rejected")
  }
  assert_eq(sequence.timescale, 1000)
  assert_eq(sequence.frames.length(), 2)
  assert_eq(sequence.frames[0].index, 0)
  assert_eq(sequence.frames[0].timestamp, 0)
  assert_eq(sequence.frames[1].index, 1)
  assert_eq(sequence.frames[1].timestamp, 40)
  assert_eq(sequence.frames[1].duration, 40)
  assert_eq(sequence.frames[1].timescale, 1000)
  let first = sequence.frames[0].image
  let second = sequence.frames[1].image
  assert_eq(second.width, 64)
  assert_eq(second.height, 64)
  let mut changed = 0
  for fy in 0..<5 {
    for fx in 0..<5 {
      let x = fx * (second.width - 1) / 4
      let y = fy * (second.height - 1) / 4
      if first.get_pixel(x, y) != second.get_pixel(x, y) {
        changed = changed + 1
      }
    }
  }
  assert_eq(changed > 0, true)
  // The inter unit is not self-contained: it names no sequence header of its
  // own and predicts from a buffer only the first unit filled. A cold decoder
  // must refuse it rather than present a picture built from nothing.
  assert_eq(
    av1_video_decode_frame(av1_video_decoder(), inter_unit) is None,
    true,
  )
}

