///|
test "inter_temporalmv_64x64: temporal-motion-vector inter frame reconstructs" {
  let (seq, headers, map) = av1_inter_parse(
    inter_temporalmv_64x64_obu, "inter_temporalmv_64x64",
  )
  let key = headers[0]
  assert_eq(key.frame_is_intra, true)
  let inter = headers[1]
  assert_eq(inter.frame_is_intra, false)
  // --enable-order-hint=1 --enable-ref-frame-mvs=1 sets the sequence flag, so
  // the frame header derives order hints and reads use_ref_frame_mvs from the
  // bitstream. Compound signalling stays off: a temporal scan is a
  // single-reference lookup, so it does not need the reference_select gate.
  assert_eq(seq.enable_order_hint, true)
  assert_eq(inter.use_ref_frame_mvs, true)
  assert_eq(inter.reference_select, false)
  assert_eq(inter.skip_mode_present, false)
  assert_eq(av1_inter_frame_supported(inter, seq), true)
  // Parsing alone must not touch the buffer: only reconstruction stores.
  assert_eq(av1_frame_map_show(map, 0) is None, true)
  let map2 = av1_frame_map()
  let whole = inter_temporalmv_64x64_obu
  let key_unit = av1_inter_slice_bytes(whole, 0, 49)
  let inter_unit = av1_inter_slice_bytes(whole, 49, 76)
  let sequence = match av1_sequence_info(key_unit) {
    Some(value) => value
    None => fail("inter_temporalmv_64x64: no sequence header")
  }
  if av1_decode_frame_planes(key_unit, map=map2) is None {
    fail("inter_temporalmv_64x64: key frame decode rejected")
  }
  // The key frame's saved motion field is intra everywhere, so its projection
  // reaches no usable cell and the temporal scan contributes no vector here;
  // what it contributes is `zero_mv_context = 1` from the block's own cell.
  // Measured: removing that single assignment fails this fixture, and removing
  // the whole scan refuses the frame, so the context it sets is pinned rather
  // than skipped.
  let frame = match av1_decode_frame_planes(inter_unit, map=map2, sequence~) {
    Some(value) => value
    None => fail("inter_temporalmv_64x64: supported inter frame rejected")
  }
  let reference = av1_inter_expand(inter_temporalmv_64x64_frame1_reference)
  let chroma = 6144 / 6
  let luma_size = 6144 - chroma * 2
  let bad = [0, 0, 0]
  for p in 0..<3 {
    let got = av1_frame_crop(frame, p)
    let start = if p == 0 {
      0
    } else if p == 1 {
      luma_size
    } else {
      luma_size + chroma
    }
    for i in 0..<got.length() {
      if got[i] != reference[start + i] {
        bad[p] = bad[p] + 1
      }
    }
  }
  assert_eq(bad, [0, 0, 0])
}

///|
test "inter_temporalmv_64x64: the key frame matches dav1d" {
  let map = av1_frame_map()
  let key_unit = av1_inter_slice_bytes(inter_temporalmv_64x64_obu, 0, 49)
  let decoded = match av1_decode_frame_planes(key_unit, map~) {
    Some(value) => value
    None => fail("inter_temporalmv_64x64: key frame decode rejected")
  }
  let reference = av1_inter_expand(inter_temporalmv_64x64_frame0_reference)
  let chroma = 6144 / 6
  let luma_size = 6144 - chroma * 2
  let bad = [0, 0, 0]
  for p in 0..<3 {
    let got = av1_frame_crop(decoded, p)
    let start = if p == 0 {
      0
    } else if p == 1 {
      luma_size
    } else {
      luma_size + chroma
    }
    for i in 0..<got.length() {
      if got[i] != reference[start + i] {
        bad[p] = bad[p] + 1
      }
    }
  }
  assert_eq(bad, [0, 0, 0])
}
