///|
test "inter_screen_content_64x64: screen-content inter frame reconstructs" {
  let (seq, headers, map) = av1_inter_parse(
    inter_screen_content_64x64_obu, "inter_screen_content_64x64",
  )
  let key = headers[0]
  assert_eq(key.frame_is_intra, true)
  let inter = headers[1]
  assert_eq(inter.frame_is_intra, false)
  // --tune-content=screen sets seq_force_screen_content_tools to SELECT, so the
  // frame header reads this bit rather than deriving it.
  assert_eq(inter.allow_screen_content_tools, true)
  // `allow_intrabc` is read only under `if ( FrameIsIntra )`, so it can never be
  // set on an inter frame; the gate entry that used to list it was dead.
  assert_eq(inter.allow_intrabc, false)
  assert_eq(av1_inter_frame_supported(inter, seq), true)
  // Parsing alone must not touch the buffer: only reconstruction stores.
  assert_eq(av1_frame_map_show(map, 0) is None, true)
  let map2 = av1_frame_map()
  let key_unit = av1_inter_slice_bytes(inter_screen_content_64x64_obu, 0, 48)
  let inter_unit = av1_inter_slice_bytes(inter_screen_content_64x64_obu, 48, 72)
  let sequence = match av1_sequence_info(key_unit) {
    Some(value) => value
    None => fail("inter_screen_content_64x64: no sequence header")
  }
  if av1_decode_frame_planes(key_unit, map=map2) is None {
    fail("inter_screen_content_64x64: key frame decode rejected")
  }
  let frame = match av1_decode_frame_planes(inter_unit, map=map2, sequence~) {
    Some(value) => value
    None => fail("inter_screen_content_64x64: supported inter frame rejected")
  }
  let reference = av1_inter_expand(inter_screen_content_64x64_frame1_reference)
  let chroma = 6144 / 6
  let luma_size = 6144 - chroma * 2
  let bad = [0, 0, 0]
  for p in 0..<3 {
    let got = av1_frame_crop(frame, p)
    let start = if p == 0 {
      0
    } else if p == 1 {
      luma_size
    } else {
      luma_size + chroma
    }
    for i in 0..<got.length() {
      if got[i] != reference[start + i] {
        bad[p] = bad[p] + 1
      }
    }
  }
  assert_eq(bad, [0, 0, 0])
}

///|
test "inter_screen_content_64x64: the refused frame's key frame still matches dav1d" {
  let whole = inter_screen_content_64x64_obu
  let key_unit = av1_inter_slice_bytes(whole, 0, 48)
  let map = av1_frame_map()
  let decoded = match av1_decode_frame_planes(key_unit, map~) {
    Some(value) => value
    None => fail("inter_screen_content_64x64: key frame decode rejected")
  }
  // The key frame carries the same screen-content flag, and the intra block
  // stage does implement palette, so it reconstructs exactly.
  let reference = av1_inter_expand(inter_screen_content_64x64_frame0_reference)
  let chroma = 6144 / 6
  let luma_size = 6144 - chroma * 2
  let bad = [0, 0, 0]
  for p in 0..<3 {
    let got = av1_frame_crop(decoded, p)
    let start = if p == 0 {
      0
    } else if p == 1 {
      luma_size
    } else {
      luma_size + chroma
    }
    for i in 0..<got.length() {
      if got[i] != reference[start + i] {
        bad[p] = bad[p] + 1
      }
    }
  }
  assert_eq(bad, [0, 0, 0])
}

