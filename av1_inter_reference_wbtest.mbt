///|
test "inter_obmc_64x64: obmc frame headers parse and the key frame matches dav1d" {
  let (seq, headers, map) = av1_inter_parse(
    inter_obmc_64x64_obu, "inter_obmc_64x64",
  )
  let key = headers[0]
  assert_eq(key.frame_is_intra, true)
  assert_eq(key.coded_lossless, false)
  let inter = headers[1]
  assert_eq(inter.frame_is_intra, false)
  // The whole point of this fixture: the frame header switches motion mode on,
  // so read_motion_mode runs and a block can select overlapped motion.
  assert_eq(inter.is_motion_mode_switchable, true)
  assert_eq(seq.enable_warped_motion, false)
  assert_eq(av1_inter_frame_supported(inter, seq), true)
  // Parsing alone must not touch the buffer: only reconstruction stores.
  assert_eq(av1_frame_map_show(map, 0) is None, true)
}

///|
test "inter_obmc_64x64: obmc inter frame reconstruction" {
  let map = av1_frame_map()
  let whole = inter_obmc_64x64_obu
  let key_unit = av1_inter_slice_bytes(whole, 0, 48)
  let inter_unit = av1_inter_slice_bytes(whole, 48, 74)
  let sequence = match av1_sequence_info(key_unit) {
    Some(value) => value
    None => fail("inter_obmc_64x64: no sequence header")
  }
  if av1_decode_frame_planes(key_unit, map~) is None {
    fail("inter_obmc_64x64: key frame decode rejected")
  }
  let inter = av1_decode_frame_planes(inter_unit, map~, sequence~)
  assert_eq(inter is Some(_), true)
  if true {
    let frame = match inter {
      Some(value) => value
      None => fail("inter_obmc_64x64: supported inter frame rejected")
    }
    let reference = av1_inter_expand(inter_obmc_64x64_frame1_reference)
    let chroma = 6144 / 6
    let luma_size = 6144 - chroma * 2
    let bad = [0, 0, 0]
    for p in 0..<3 {
      let got = av1_frame_crop(frame, p)
      let start = if p == 0 {
        0
      } else if p == 1 {
        luma_size
      } else {
        luma_size + chroma
      }
      for i in 0..<got.length() {
        if got[i] != reference[start + i] {
          bad[p] = bad[p] + 1
        }
      }
    }
    assert_eq(bad, [0, 0, 0])
  }
}

