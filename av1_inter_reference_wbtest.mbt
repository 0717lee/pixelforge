///|
test "inter_skipmode_64x64: skip-mode frame headers parse and the key frame matches dav1d" {
  let map = av1_frame_map()
  let whole = inter_skipmode_64x64_obu
  let key_unit = Array::makei(84, i => whole[i])
  let mid_unit = Array::makei(110 - 84, i => whole[84 + i])
  let skip_unit = Array::makei(whole.length() - 110, i => whole[110 + i])
  let sequence = match av1_sequence_info(key_unit) {
    Some(value) => value
    None => fail("inter_skipmode_64x64: no sequence header")
  }
  // The order hint is what makes the derivation reachable: the key frame's
  // hint is moved ahead of the third frame's, so a reference sits on either
  // side of it.
  assert_eq(sequence.enable_order_hint, true)

  if av1_decode_frame_planes(key_unit, map~) is None {
    fail("inter_skipmode_64x64: key frame decode rejected")
  }
  // The two earlier frames are the untouched encode; the third is the patched
  // one. All three are compared so the reference-slot state that carries
  // across them is pinned too.
  let units : Array[(Array[Byte], Array[Int], String)] = [
    (key_unit, inter_skipmode_64x64_frame0_reference, "key"),
    (mid_unit, inter_skipmode_64x64_frame1_reference, "mid"),
    (skip_unit, inter_skipmode_64x64_frame2_reference, "skip"),
  ]
  let mut index = 0
  while index < units.length() {
    let unit = units[index]
    let payload = unit.0
    let reference_data = unit.1
    let label = unit.2
    let decoded = if label == "key" {
      av1_decode_frame_planes(payload, map=map)
    } else {
      av1_decode_frame_planes(payload, map=map, sequence=sequence)
    }
    let frame = match decoded {
      Some(value) => value
      None => fail("inter_skipmode_64x64: " + label + " frame decode rejected")
    }
    let reference = av1_inter_expand(reference_data)
    let chroma = 6144 / 6
    let luma_size = 6144 - chroma * 2
    let bad = [0, 0, 0]
    for p in 0..<3 {
      let got = av1_frame_crop(frame, p)
      let start = if p == 0 {
        0
      } else if p == 1 {
        luma_size
      } else {
        luma_size + chroma
      }
      for i in 0..<got.length() {
        if got[i] != reference[start + i] {
          bad[p] = bad[p] + 1
        }
      }
    }
    assert_eq(bad, [0, 0, 0])
    index = index + 1
  }
}
