///|
test "inter_compound_64x64: compound frame headers parse and the key frame matches dav1d" {
  let (seq, headers, map) = av1_inter_parse(
    inter_compound_64x64_obu, "inter_compound_64x64",
  )
  assert_eq(seq.reduced_still_picture_header, false)
  assert_eq(seq.enable_order_hint, false)
  assert_eq(seq.enable_warped_motion, false)
  assert_eq(seq.enable_dual_filter, false)
  assert_eq(seq.enable_ref_frame_mvs, false)
  assert_eq(seq.enable_interintra_compound, false)
  assert_eq(seq.enable_masked_compound, false)
  assert_eq(seq.use_128x128_superblock, true)
  assert_eq(seq.enable_superres, false)

  let key = headers[0]
  assert_eq(key.frame_type, av1_key_frame)
  assert_eq(key.frame_is_intra, true)
  assert_eq(key.show_frame, true)
  assert_eq(key.primary_ref_frame, av1_primary_ref_none)
  assert_eq(key.refresh_frame_flags, 255)

  let inter = headers[1]
  assert_eq(inter.frame_type, av1_inter_frame)
  assert_eq(inter.frame_is_intra, false)
  assert_eq(inter.show_frame, true)
  assert_eq(inter.error_resilient, false)
  assert_eq(inter.primary_ref_frame, 7)
  assert_eq(inter.refresh_frame_flags, 2)
  assert_eq(inter.ref_frame_idx.length(), av1_refs_per_frame)
  for slot in inter.ref_frame_idx {
    assert_eq(slot, 0)
  }
  assert_eq(inter.allow_high_precision_mv, false)
  assert_eq(inter.interpolation_filter, 4)
  assert_eq(inter.allow_warped_motion, false)
  assert_eq(inter.use_ref_frame_mvs, false)
  assert_eq(inter.is_motion_mode_switchable, false)
  // The one byte that separates this fixture from inter_shift_64x64.
  assert_eq(inter.reference_select, true)
  assert_eq(inter.skip_mode_present, false)
  assert_eq(inter.allow_intrabc, false)
  for typ in inter.gm_type {
    assert_eq(typ, av1_gm_identity)
  }

  // Parsing alone must not touch the buffer: only reconstruction stores.
  assert_eq(av1_frame_map_show(map, 0) is None, true)
}

///|
test "inter_compound_64x64: compound inter frame reconstructs" {
  let map = av1_frame_map()
  let whole = inter_compound_64x64_obu
  let key_unit = av1_inter_slice_bytes(whole, 0, 82)
  let inter_unit = av1_inter_slice_bytes(whole, 82, whole.length())
  let sequence = match av1_sequence_info(key_unit) {
    Some(value) => value
    None => fail("inter_compound_64x64: no sequence header")
  }
  if av1_decode_frame_planes(key_unit, map~) is None {
    fail("inter_compound_64x64: key frame decode rejected")
  }
  // With reference_select patched on, the block layer reads comp_mode and the
  // frame decodes compound blocks: two references, two motion vectors, and the
  // COMPOUND_AVERAGE blend the frame's sequence flags allow. A wedge or
  // distance-weighted block would still refuse the frame whole.
  let inter = av1_decode_frame_planes(inter_unit, map~, sequence~)
  assert_eq(inter is Some(_), true)
  if true {
    let frame = match inter {
      Some(value) => value
      None => fail("inter_compound_64x64: supported inter frame rejected")
    }
    let reference = av1_inter_expand(inter_compound_64x64_frame1_reference)
    let chroma = 6144 / 6
    let luma_size = 6144 - chroma * 2
    let bad = [0, 0, 0]
    for p in 0..<3 {
      let got = av1_frame_crop(frame, p)
      let start = if p == 0 {
        0
      } else if p == 1 {
        luma_size
      } else {
        luma_size + chroma
      }
      for i in 0..<got.length() {
        if got[i] != reference[start + i] {
          bad[p] = bad[p] + 1
        }
      }
    }
    assert_eq(bad, [0, 0, 0])
  }
}
