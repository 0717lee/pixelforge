let mainline_deltalf_8bit_128x128_obu : Array[Byte] = [
  b'\x12', b'\x00', b'\x0A', b'\x06', b'\x18', b'\x19', b'\xBF', b'\xFF', b'\x60',
  b'\x02', b'\x32', b'\xFE', b'\x0C', b'\x12', b'\x00', b'\x1A', b'\x80', b'\x04',
