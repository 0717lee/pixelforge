  let data = mainline_segmentation_inherit_8bit_128x128_obu
  let sequence = av1_sequence_info(data).unwrap()
  let payloads = av1_obu_payloads(data, 6)
  assert_eq(payloads.length(), 4)
  let map = av1_frame_map()
  let reference = mainline_segmentation_inherit_8bit_128x128_reference
  let mut offset = 0
  for payload in payloads {
    let unit : Array[Byte] = [b'\x32']
    let mut size = payload.length()
    while size >= 128 {
      unit.push(((size & 127) | 128).to_byte())
      size = size >> 7
    }
    unit.push(size.to_byte())
    for value in payload {
      unit.push(value)
    }
    let frame = match
      av1_decode_frame_planes(unit, sequence~, map~, allow_monochrome=true) {
      Some(value) => value
      None => fail("segmentation_inherit_8bit_128x128: decode rejected")
    }
    assert_eq((frame.width, frame.height, frame.bit_depth), (128, 128, 8))
    for plane in 0..<3 {
      let actual = av1_frame_crop(frame, plane)
      for i in 0..<actual.length() {
        assert_eq((plane, i, actual[i]), (plane, i, reference[offset + i]))
      }
      offset = offset + actual.length()
    }
  }
  assert_eq(offset, reference.length())
}

