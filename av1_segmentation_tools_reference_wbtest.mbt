    16, 140, 16, 148, 16, 140, 16, 148, 16, 140, 16, 148, 16, 140, 16, 148, 16, 140,
    16, 148, 16, 140, 16, 148, 16, 140, 16, 148, 16, 140, 16, 148, 16, 140, 16, 148,
    16, 140, 16, 148, 16, 140, 16, 148, 16, 140, 16, 148, 16, 140, 16, 148, 16, 146,
    16, 154, 16, 146, 16, 154, 16, 146, 16, 154, 16, 146, 16, 154, 16, 146, 16, 154,
