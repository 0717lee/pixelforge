  let map = av1_frame_map()
  let (_, frames) = av1_decode_obu_planes(stream, map, None, false).unwrap()
  assert_eq(frames.length(), 2)
  let mut offset = 0
  for frame in frames {
    for plane in 0..<3 {
      let samples = av1_frame_crop(frame, plane)
      for i in 0..<samples.length() {
        assert_eq(samples[i], expected[offset + i])
      }
      offset = offset + samples.length()
    }
  }
  assert_eq(offset, expected.length())
  let segments = map.saved_segmentation[1]
  assert_true(segments.seg_id_pre_skip)
  assert_true(segments.feature_enabled[0][7])
  assert_eq(segments.feature_data[0][7], 0)
  assert_true(segments.feature_enabled[0][4])
  assert_eq(segments.feature_data[0][4], -16)
}
