/// Generated by scripts/generate-av1-segmentation-tools-reference.py.
/// Controlled complete tiles, independently decoded by dav1d 1.2.1.

///|
fn av1_segment_tools_bytes(hex : String) -> Array[Byte] {
  let chars = hex.to_array()
  let nibble = fn(c : Char) {
    if c <= '9' {
      c.to_int() - 48
    } else {
      c.to_int() - 87
    }
  }
  Array::makei(chars.length() / 2, i => {
    (16 * nibble(chars[2 * i]) + nibble(chars[2 * i + 1])).to_byte()
  })
}

///|
fn av1_segment_tools_samples(pairs : Array[Int]) -> Array[Int] {
  let values : Array[Int] = []
  for i in 0..<(pairs.length() / 2) {
    for _ in 0..<pairs[i * 2 + 1] {
      values.push(pairs[i * 2])
    }
  }
  values
}

