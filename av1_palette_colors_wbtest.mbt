/// Isolated palette colors/literal/ns transcripts generated by
/// scripts/generate-av1-palette-colors-reference.py using scripts/craft_av1_fixture.py
/// MsacEncoder and pinned AOM 8e7b6a567df174d795479b92b4ac766d271add73 CDFs.
/// The generator replays all operations through MsacDecoder and checks
/// final CDFs and trailing markers. These are not complete AV1 fixtures.

///|
test "palette colors default mode and size CDFs match original AOM" {
  let state = av1_palette_state(8, 8)
  assert_eq(state.y_mode, [
    [[31676, 32768, 0], [3419, 32768, 0], [1261, 32768, 0]],
    [[31912, 32768, 0], [2859, 32768, 0], [980, 32768, 0]],
    [[31823, 32768, 0], [3400, 32768, 0], [781, 32768, 0]],
    [[32030, 32768, 0], [3561, 32768, 0], [904, 32768, 0]],
    [[32309, 32768, 0], [7337, 32768, 0], [1462, 32768, 0]],
    [[32265, 32768, 0], [4015, 32768, 0], [1521, 32768, 0]],
    [[32450, 32768, 0], [7946, 32768, 0], [129, 32768, 0]],
  ])
  assert_eq(state.uv_mode, [[32461, 32768, 0], [21488, 32768, 0]])
  assert_eq(state.y_size, [
    [7952, 13000, 18149, 21478, 25527, 29241, 32768, 0],
    [7139, 11421, 16195, 19544, 23666, 28073, 32768, 0],
    [7788, 12741, 17325, 20500, 24315, 28530, 32768, 0],
    [8271, 14064, 18246, 21564, 25071, 28533, 32768, 0],
    [12725, 19180, 21863, 24839, 27535, 30120, 32768, 0],
    [9711, 14888, 16923, 21052, 25661, 27875, 32768, 0],
    [14940, 20797, 21678, 24186, 27033, 28999, 32768, 0],
  ])
  assert_eq(state.uv_size, [
    [8713, 19979, 27128, 29609, 31331, 32272, 32768, 0],
    [5839, 15573, 23581, 26947, 29848, 31700, 32768, 0],
    [4426, 11260, 17999, 21483, 25863, 29430, 32768, 0],
    [3228, 9464, 14993, 18089, 22523, 27420, 32768, 0],
    [3768, 8886, 13091, 17852, 22495, 27207, 32768, 0],
    [2464, 8451, 12861, 21632, 25525, 28555, 32768, 0],
    [1269, 5435, 10433, 18963, 21700, 25865, 32768, 0],
  ])
}

///|
test "palette colors nonadaptive literal native bit widths and zero count" {
  let state = av1_palette_state(8, 8)
  let decoder = av1_msac_new(
    [b'\xa6', b'\xaf', b'\xd8', b'\x3d', b'\x66'],
    true,
  )
  let before = (
    decoder.symbol_value,
    decoder.symbol_range,
    decoder.symbol_max_bits,
  )
  assert_eq(av1_palette_literal(decoder, 0), 0)
  assert_eq(
    (decoder.symbol_value, decoder.symbol_range, decoder.symbol_max_bits),
    before,
  )
  assert_eq(av1_palette_literal(decoder, 8), 166)
  assert_eq(av1_palette_literal(decoder, 10), 725)
  assert_eq(av1_palette_literal(decoder, 12), 2873)
  assert_eq(av1_palette_literal(decoder, 8), 0xa5)
  assert_true(decoder.allow_update)
  assert_eq(state.y_mode[0][0], [31676, 32768, 0])
}

///|
test "palette colors ns every value for1 through8 preserves next marker" {
  let decoder = av1_msac_new(
    [
      b'\x48', b'\x56', b'\x6d', b'\x39', b'\x6a', b'\x14', b'\x7b', b'\xf1', b'\x9d',
      b'\x88', b'\x45', b'\x48', b'\x24', b'\x2a', b'\xa7', b'\x8c', b'\xb0', b'\x34',
      b'\xf5', b'\x6b', b'\x7c', b'\x50', b'\xa7', b'\xd8', b'\x33', b'\x6d', b'\x5c',
      b'\x93', b'\xd5', b'\x09', b'\xae', b'\x17', b'\x5f', b'\x1f', b'\x6a', b'\x5c',
      b'\x1b', b'\xcc', b'\xfe', b'\xd8', b'\x42', b'\x15', b'\x24', b'\x40', b'\xbb',
      b'\x9d', b'\xe2', b'\x80',
    ],
    true,
  )
  for n in 1..<9 {
    for value in 0..<n {
      assert_eq(av1_palette_ns(decoder, n), Some(value))
      assert_eq(av1_palette_literal(decoder, 8), 0x40 + n * 8 + value)
    }
  }
  let before = (
    decoder.symbol_value,
    decoder.symbol_range,
    decoder.symbol_max_bits,
  )
  for n in [0, 9] {
    assert_eq(av1_palette_ns(decoder, n), None)
  }
  assert_eq(
    (decoder.symbol_value, decoder.symbol_range, decoder.symbol_max_bits),
    before,
  )
}

///|
test "palette colors Y plus1 shrinking range and clamp" {
  {
    let state = av1_palette_state(8, 8)
    let decoder = av1_msac_new(
      [b'\xfc', b'\x30', b'\xb1', b'\xef', b'\x80'],
      true,
    )
    assert_true(
      av1_palette_read_colors(
        decoder,
        state,
        { row: 0, col: 0, width: 8, height: 8, },
        8,
        0,
        0,
        false,
        true,
      ),
    )
    assert_eq(state.y_colors, [252, 253, 255, 255])
    assert_eq(state.u_colors, [])
    assert_eq(state.v_colors, [])
    for index in [0, 1, 8, 9] {
      assert_eq(state.y_neighbors[index], [252, 253, 255, 255])
    }
    assert_eq(av1_palette_literal(decoder, 8), 0xa5)
  }
  {
    let state = av1_palette_state(8, 8)
    let decoder = av1_msac_new(
      [b'\xfc', b'\x34', b'\xac', b'\x12', b'\xf8'],
      true,
    )
    assert_true(
      av1_palette_read_colors(
        decoder,
        state,
        { row: 0, col: 0, width: 8, height: 8, },
        10,
        0,
        0,
        false,
        true,
      ),
    )
    assert_eq(state.y_colors, [1020, 1021, 1023, 1023])
    assert_eq(state.u_colors, [])
    assert_eq(state.v_colors, [])
    for index in [0, 1, 8, 9] {
      assert_eq(state.y_neighbors[index], [1020, 1021, 1023, 1023])
    }
    assert_eq(av1_palette_literal(decoder, 8), 0xa5)
  }
  let state = av1_palette_state(8, 8)
  let decoder = av1_msac_new(
    [b'\xfc', b'\x35', b'\xaa', b'\xfe', b'\x2f', b'\x80'],
    true,
  )
  assert_true(
    av1_palette_read_colors(
      decoder,
      state,
      { row: 0, col: 0, width: 8, height: 8, },
      12,
      0,
      0,
      false,
      true,
    ),
  )
  assert_eq(state.y_colors, [4092, 4093, 4095, 4095])
  assert_eq(state.u_colors, [])
  assert_eq(state.v_colors, [])
  for index in [0, 1, 8, 9] {
    assert_eq(state.y_neighbors[index], [4092, 4093, 4095, 4095])
  }
  assert_eq(av1_palette_literal(decoder, 8), 0xa5)
}

