///|
test "palette colors cache merge unique and64pixel boundary preserves mode context" {
  let state = av1_palette_state(8, 32)
  state.y_neighbors[10] = [10, 30, 50]
  state.y_neighbors[17] = [20, 30, 40]
  state.u_neighbors[10] = [4, 4, 9]
  state.u_neighbors[17] = [1, 4, 10]
  assert_eq(
    av1_palette_cache(state, { row: 8, col: 8, width: 8, height: 8, }, 0),
    [10, 20, 30, 40, 50],
  )
  assert_eq(
    av1_palette_cache(state, { row: 8, col: 8, width: 8, height: 8, }, 1),
    [1, 4, 9, 10],
  )
  assert_eq(
    av1_palette_mode_context(state, { row: 8, col: 8, width: 8, height: 8, }),
    2,
  )
  state.y_neighbors[122] = [10, 30, 50]
  state.y_neighbors[129] = [20, 30, 40]
  state.u_neighbors[122] = [4, 9]
  state.u_neighbors[129] = [1, 10]
  assert_eq(
    av1_palette_cache(state, { row: 64, col: 8, width: 8, height: 8, }, 0),
    [20, 30, 40],
  )
  assert_eq(
    av1_palette_cache(state, { row: 64, col: 8, width: 8, height: 8, }, 1),
    [1, 10],
  )
  assert_eq(
    av1_palette_mode_context(state, { row: 64, col: 8, width: 8, height: 8, }),
    2,
  )
}

///|
test "palette colors all Y cached stops reading flags at requested count" {
  let state = av1_palette_state(8, 8)
  let decoder = av1_msac_new([b'\x4d', b'\xe4'], true)
  state.y_neighbors[17] = [5, 15, 25, 35]
  assert_true(
    av1_palette_read_colors(
      decoder,
      state,
      { row: 8, col: 8, width: 8, height: 8, },
      8,
      0,
      0,
      false,
      true,
    ),
  )
  assert_eq(state.y_colors, [5, 15])
  assert_eq(av1_palette_literal(decoder, 8), 0xa5)
}

///|
test "palette colors partial Y cache merges selected and transmitted lists" {
  let state = av1_palette_state(8, 8)
  let decoder = av1_msac_new([b'\x81', b'\xbf', b'\x37', b'\x62'], true)
  state.y_neighbors[10] = [5, 25]
  state.y_neighbors[17] = [15, 25, 35]
  assert_true(
    av1_palette_read_colors(
      decoder,
      state,
      { row: 8, col: 8, width: 8, height: 8, },
      8,
      0,
      0,
      false,
      true,
    ),
  )
  assert_eq(state.y_colors, [5, 10, 20, 35])
  assert_eq(av1_palette_literal(decoder, 8), 0xa5)
}

