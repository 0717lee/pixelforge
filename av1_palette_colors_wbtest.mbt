test "palette colors blocks_frozen context0 1 2 and nonpalette clearing preserve prior refs" {
  let state = av1_palette_state(8, 8)
  let decoder = av1_msac_new(
    [
      b'\xf7', b'\x8d', b'\x8a', b'\x2f', b'\xf3', b'\xa8', b'\x80', b'\x22', b'\x8b',
      b'\x8b', b'\x56', b'\x4b', b'\x26', b'\x84',
    ],
    false,
  )
  assert_true(
    av1_palette_read_colors(
      decoder,
      state,
      { row: 0, col: 0, width: 8, height: 8, },
      8,
      0,
      0,
      false,
      true,
    ),
  )
  assert_eq(state.y_colors, [10, 20])
  assert_eq(av1_palette_literal(decoder, 8), 161)
  assert_true(
    av1_palette_read_colors(
      decoder,
      state,
      { row: 0, col: 8, width: 8, height: 8, },
      8,
      0,
      0,
      false,
      true,
    ),
  )
  assert_eq(state.y_colors, [10, 20])
  assert_eq(av1_palette_literal(decoder, 8), 162)
  assert_true(
    av1_palette_read_colors(
      decoder,
      state,
      { row: 8, col: 0, width: 8, height: 8, },
      8,
      0,
      0,
      false,
      true,
    ),
  )
  assert_eq(state.y_colors, [10, 20])
  assert_eq(av1_palette_literal(decoder, 8), 163)
  assert_true(
    av1_palette_read_colors(
      decoder,
      state,
      { row: 8, col: 8, width: 8, height: 8, },
      8,
      0,
      0,
      false,
      true,
    ),
  )
  assert_eq(state.y_colors, [10, 20])
  assert_eq(av1_palette_literal(decoder, 8), 164)
  let old_colors = state.y_colors
  let old_neighbor = state.y_neighbors[10]
  assert_true(
    av1_palette_read_colors(
      decoder,
      state,
      { row: 8, col: 8, width: 8, height: 8, },
      8,
      0,
      0,
      false,
      true,
    ),
  )
  assert_eq(state.y_colors, [])
  for index in [18, 19, 26, 27] {
    assert_eq(state.y_neighbors[index], [])
  }
  assert_eq(av1_palette_literal(decoder, 8), 0xa5)
  assert_true(
    av1_palette_read_colors(
      decoder,
      state,
      { row: 16, col: 8, width: 8, height: 8, },
      8,
      0,
      0,
      false,
      true,
    ),
  )
  assert_eq(state.y_colors, [30, 40])
  assert_eq(old_colors, [10, 20])
  assert_eq(old_neighbor, [10, 20])
  assert_eq(av1_palette_literal(decoder, 8), 0xa6)
  assert_eq(state.y_mode, [
    [[31676, 32768, 0], [3419, 32768, 0], [1261, 32768, 0]],
    [[31912, 32768, 0], [2859, 32768, 0], [980, 32768, 0]],
    [[31823, 32768, 0], [3400, 32768, 0], [781, 32768, 0]],
    [[32030, 32768, 0], [3561, 32768, 0], [904, 32768, 0]],
    [[32309, 32768, 0], [7337, 32768, 0], [1462, 32768, 0]],
    [[32265, 32768, 0], [4015, 32768, 0], [1521, 32768, 0]],
    [[32450, 32768, 0], [7946, 32768, 0], [129, 32768, 0]],
  ])
  assert_eq(state.y_size, [
    [7952, 13000, 18149, 21478, 25527, 29241, 32768, 0],
    [7139, 11421, 16195, 19544, 23666, 28073, 32768, 0],
    [7788, 12741, 17325, 20500, 24315, 28530, 32768, 0],
    [8271, 14064, 18246, 21564, 25071, 28533, 32768, 0],
    [12725, 19180, 21863, 24839, 27535, 30120, 32768, 0],
    [9711, 14888, 16923, 21052, 25661, 27875, 32768, 0],
    [14940, 20797, 21678, 24186, 27033, 28999, 32768, 0],
  ])
  assert_eq(state.uv_mode, [[32461, 32768, 0], [21488, 32768, 0]])
  assert_eq(state.uv_size, [
    [8713, 19979, 27128, 29609, 31331, 32272, 32768, 0],
    [5839, 15573, 23581, 26947, 29848, 31700, 32768, 0],
    [4426, 11260, 17999, 21483, 25863, 29430, 32768, 0],
    [3228, 9464, 14993, 18089, 22523, 27420, 32768, 0],
    [3768, 8886, 13091, 17852, 22495, 27207, 32768, 0],
    [2464, 8451, 12861, 21632, 25525, 28555, 32768, 0],
    [1269, 5435, 10433, 18963, 21700, 25865, 32768, 0],
  ])
}

///|
test "palette colors legal noneligible or gated blocks clear colors without consuming syntax" {
  for kind in 0..<4 {
    let state = av1_palette_state(40, 40)
    let decoder = av1_msac_new([b'\xa5', b'\x80'], true)
    state.y_colors = [10, 20]
    state.u_colors = [30, 40]
    state.v_colors = [50, 60]
    state.y_neighbors[0] = [10, 20]
    state.u_neighbors[0] = [30, 40]
    let block : Av1SbBlock = {
      row: 0,
      col: 0,
      width: if kind == 2 {
        4
      } else if kind == 3 {
        128
      } else {
        8
      },
      height: if kind == 3 {
        64
      } else {
        8
      },
    }
    let before = (
      decoder.symbol_value,
      decoder.symbol_range,
      decoder.symbol_max_bits,
    )
    assert_true(
      av1_palette_read_colors(
        decoder,
        state,
        block,
        8,
        if kind == 1 {
          1
        } else {
          0
        },
        if kind == 1 {
          1
        } else {
          0
        },
        true,
        kind != 0,
      ),
    )
    assert_eq(
      (decoder.symbol_value, decoder.symbol_range, decoder.symbol_max_bits),
      before,
    )
    assert_eq(state.y_colors, [])
    assert_eq(state.u_colors, [])
    assert_eq(state.v_colors, [])
    assert_eq(state.y_neighbors[0], [])
    assert_eq(state.u_neighbors[0], [])
    assert_eq(av1_palette_literal(decoder, 8), 0xa5)
  }
}

///|
test "palette colors 4x16 16x4 eligibility and edge footprint clip to MI bounds" {
  for shape in [(4, 16), (16, 4), (8, 8)] {
    let state = av1_palette_state(3, 3)
    let decoder = av1_msac_new([b'\xf7', b'\x8d', b'\x8a', b'\x42'], true)
    let (width, height) = shape
    let block : Av1SbBlock = { row: 8, col: 8, width, height, }
    assert_true(
      av1_palette_read_colors(decoder, state, block, 8, 0, 0, false, true),
    )
    assert_eq(state.y_colors, [10, 20])
    assert_eq(state.y_neighbors[8], [10, 20])
    assert_eq(state.y_neighbors.length(), 9)
    for index in 0..<8 {
      assert_eq(state.y_neighbors[index], [])
    }
    assert_eq(av1_palette_literal(decoder, 8), 0xa5)
  }
}

///|
test "palette colors malformed geometry depth and mode rejected" {
  let invalid_blocks : Array[Av1SbBlock] = [
    { row: -4, col: 0, width: 8, height: 8, },
    { row: 0, col: 2, width: 8, height: 8, },
    { row: 32, col: 0, width: 8, height: 8, },
    { row: 0, col: 32, width: 8, height: 8, },
    { row: 0, col: 0, width: 12, height: 8, },
  ]
  for block in invalid_blocks {
    let state = av1_palette_state(8, 8)
    let decoder = av1_msac_new([b'\xf7', b'\x8d', b'\x8a', b'\x42'], true)
    let before = (
      decoder.symbol_value,
      decoder.symbol_range,
      decoder.symbol_max_bits,
    )
    assert_false(
      av1_palette_read_colors(decoder, state, block, 8, 0, 0, false, true),
    )
    assert_eq(
      (decoder.symbol_value, decoder.symbol_range, decoder.symbol_max_bits),
      before,
    )
  }
  for depth in [0, 7, 9, 11, 13] {
    let state = av1_palette_state(8, 8)
    let decoder = av1_msac_new([b'\xf7', b'\x8d', b'\x8a', b'\x42'], true)
    assert_false(
      av1_palette_read_colors(
        decoder,
        state,
        { row: 0, col: 0, width: 8, height: 8, },
        depth,
        0,
        0,
        false,
        true,
      ),
    )
  }
  for mode in [-1, 13] {
    let state = av1_palette_state(8, 8)
    let decoder = av1_msac_new([b'\xf7', b'\x8d', b'\x8a', b'\x42'], true)
    assert_false(
      av1_palette_read_colors(
        decoder,
        state,
        { row: 0, col: 0, width: 8, height: 8, },
        8,
        mode,
        0,
        false,
        true,
      ),
    )
  }
}

///|
test "palette colors truncated long palette rejects entropy padding overflow" {
  let state = av1_palette_state(8, 8)
  let decoder = av1_msac_new(
    [
      b'\xff', b'\x1b', b'\xc9', b'\x72', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00',
      b'\x00', b'\x04', b'\xca',
    ],
    true,
  )
  assert_true(
    av1_palette_read_colors(
      decoder,
      state,
      { row: 0, col: 0, width: 8, height: 8, },
      12,
      0,
      0,
      false,
      true,
    ),
  )
  assert_eq(state.y_colors, [100, 101, 102, 103, 104, 105, 106, 107])
  assert_eq(av1_palette_literal(decoder, 8), 0xa5)
  let truncated = av1_msac_new([b'\xff'], true)
  assert_false(
    av1_palette_read_colors(
      truncated,
      av1_palette_state(8, 8),
      { row: 0, col: 0, width: 8, height: 8, },
      12,
      0,
      0,
      false,
      true,
    ),
  )
}
