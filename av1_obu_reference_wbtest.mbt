///|
test "OBU assembly split_two_tile_groups: independent displayed native planes" {
  let decoder = av1_video_decoder()
  let frames = av1_video_decode_temporal_unit_planes(
    decoder, obu_split_two_tile_groups_data,
  ).unwrap()
  assert_eq(frames.length(), 1)
  let mut offset = 0
  for frame in frames {
    assert_eq((frame.width, frame.height), (128, 64))
    for plane in 0..<3 {
      for value in av1_frame_crop(frame, plane) {
        assert_eq(value, obu_split_two_tile_groups_reference[offset].to_int())
        offset = offset + 1
      }
    }
  }
  assert_eq(offset, obu_split_two_tile_groups_reference.length())
}

