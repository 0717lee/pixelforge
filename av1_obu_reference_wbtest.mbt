///|
test "OBU assembly layer_timing_32bit: independent displayed native planes" {
  let decoder = av1_video_decoder()
  let frames = av1_video_decode_temporal_unit_planes(
    decoder, obu_layer_timing_32bit_data,
  ).unwrap()
  assert_eq(frames.length(), 2)
  let mut offset = 0
  for frame in frames {
    assert_eq((frame.width, frame.height), (64, 64))
    for plane in 0..<3 {
      for value in av1_frame_crop(frame, plane) {
        assert_eq(value, obu_layer_timing_32bit_reference[offset].to_int())
        offset = offset + 1
      }
    }
  }
  assert_eq(offset, obu_layer_timing_32bit_reference.length())
}

