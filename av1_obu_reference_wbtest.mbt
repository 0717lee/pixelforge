///|
test "OBU assembly hidden_inter_show_existing: independent displayed native planes" {
  let decoder = av1_video_decoder()
  let frames = av1_video_decode_temporal_unit_planes(
    decoder, obu_hidden_inter_show_existing_data,
  ).unwrap()
  assert_eq(frames.length(), 3)
  let mut offset = 0
  for frame in frames {
    assert_eq((frame.width, frame.height), (64, 64))
    for plane in 0..<3 {
      for value in av1_frame_crop(frame, plane) {
        assert_eq(
          value,
          obu_hidden_inter_show_existing_reference[offset].to_int(),
        )
        offset = offset + 1
      }
    }
  }
  assert_eq(offset, obu_hidden_inter_show_existing_reference.length())
}

