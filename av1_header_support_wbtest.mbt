/// Shared literal bases for the AV1 header white-box tests.

///|
/// The reduced still-picture derivations from §5.9.1. Header tests spread this
/// so a new sequence field cannot silently default to an arbitrary value.
let av1_reduced_still_sequence : Av1SequenceInfo = {
  profile: 0,
  width: 0,
  height: 0,
  bit_depth: 8,
  monochrome: false,
  subsampling_x: true,
  subsampling_y: true,
  reduced_still_picture_header: true,
  use_128x128_superblock: false,
  enable_filter_intra: false,
  enable_intra_edge_filter: false,
  enable_superres: false,
  enable_cdef: false,
  enable_restoration: false,
  full_range: false,
  separate_uv_delta_q: false,
  film_grain_params_present: false,
  color_primaries: 2,
  transfer_characteristics: 2,
  matrix_coefficients: 2,
  still_picture: true,
  enable_order_hint: false,
  order_hint_bits: 0,
  enable_ref_frame_mvs: false,
  enable_warped_motion: false,
  enable_dual_filter: false,
  enable_jnt_comp: false,
  enable_masked_compound: false,
  enable_interintra_compound: false,
  seq_force_screen_content_tools: av1_select_screen_content_tools,
  seq_force_integer_mv: av1_select_integer_mv,
  frame_id_numbers_present: false,
  delta_frame_id_length_minus_2: 0,
  additional_frame_id_length_minus_1: 0,
  decoder_model_info_present: false,
  equal_picture_interval: false,
  buffer_delay_length_minus_1: 0,
  buffer_removal_time_length_minus_1: 0,
  frame_presentation_time_length_minus_1: 0,
  operating_points_cnt_minus_1: 0,
  operating_point_idc: [0],
  frame_width_bits_minus_1: 0,
  frame_height_bits_minus_1: 0,
}
