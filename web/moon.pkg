// Browser bindings package: wraps the PixelForge core library and links it as
// a foreign library so the js backend emits a clean ES module.
import {
  "0717lee/pixelforge",
}

pkgtype(kind: "foreign_library")

options(
  link: {
    "js": {
      "exports": [ "apply_filter", "encode_png", "luma_histogram" ],
      "format": "esm",
    },
  },
)
