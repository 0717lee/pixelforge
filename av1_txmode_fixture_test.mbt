///|
/// Crafted tx_mode=SELECT fixtures (scripts/craft_av1_fixture.py), validated
/// against ffmpeg/libdav1d. Each test decodes the embedded OBU stream and
/// compares the full RGBA output against the reference planes decoded by
/// dav1d, converted through the shared YUV->RGBA path.
fn hex_bytes(hex : String) -> Array[Byte] {
  let out : Array[Byte] = []
  let chars = hex.to_array()
  for i in 0..<(chars.length() / 2) {
    fn nibble(c : Char) -> Int {
      if c >= '0' && c <= '9' {
        c.to_int() - '0'.to_int()
      } else {
        c.to_int() - 'a'.to_int() + 10
      }
    }
    out.push((nibble(chars[i * 2]) * 16 + nibble(chars[i * 2 + 1])).to_byte())
  }
  out
}

///|
fn rgba_from_planes(width : Int, yuv_hex : String) -> Image {
  let data = hex_bytes(yuv_hex)
  let n = width * width
  let y : Array[Byte] = []
  let u : Array[Byte] = []
  let v : Array[Byte] = []
  for i in 0..<n {
    y.push(data[i])
  }
  for i in 0..<(n >> 2) {
    u.push(data[n + i])
    v.push(data[n + (n >> 2) + i])
  }
  av1_yuv420_to_rgba_color(width, width, y, u, v).unwrap()
}

///|
test "crafted tx-mode depth1_64 matches libdav1d" {
  let stream = hex_bytes(
    "12000a0618157ffc00083208178000002008f9e0",
  )
  let actual = av1_decode(stream).unwrap()
  let expected = rgba_from_planes(64, "")
  for y in 0..<64 {
    for x in 0..<64 {
      assert_eq(actual.get_pixel(x, y), expected.get_pixel(x, y))
    }
  }
}
