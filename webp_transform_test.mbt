/// External VP8L fixture encoded by libwebp/Pillow.  It contains predictor
/// and cross-color transforms plus a non-trivial Huffman tree.
test "webp_decode handles predictor and color transforms" {
  let encoded : Array[Byte] = [
    0x52, 0x49, 0x46, 0x46, 0x3C, 0x00, 0x00, 0x00, 0x57, 0x45, 0x42, 0x50,
    0x56, 0x50, 0x38, 0x4C, 0x30, 0x00, 0x00, 0x00, 0x2F, 0x3F, 0xC0, 0x0F,
    0x00, 0xB9, 0x8C, 0xE8, 0x7F, 0x0C, 0x84, 0x04, 0x09, 0xFF, 0x8F, 0x1B,
    0xAD, 0x31, 0x10, 0xFD, 0x9F, 0x00, 0xA9, 0xBF, 0xA0, 0x20, 0x6D, 0x03,
    0xA6, 0x3B, 0xFE, 0x8D, 0x4F, 0xC0, 0x14, 0x02, 0x08, 0x80, 0x82, 0x66,
    0x0E, 0x62, 0x02, 0x00, 0x5F, 0xEF, 0xEE, 0x3B,
  ]
  let decoded = webp_decode(encoded).unwrap()
  assert_eq((decoded.width, decoded.height), (64, 64))
  for y in 0..<64 {
    for x in 0..<64 {
      let i = (y * 64 + x) * 4
      assert_eq((x, y, decoded.data[i]), (x, y, ((x * 3 + y * 5) % 256).to_byte()))
      assert_eq(decoded.data[i + 1], ((y * 4) % 256).to_byte())
      assert_eq(decoded.data[i + 2], ((x * 7) % 256).to_byte())
      assert_eq(decoded.data[i + 3], b'\xFF')
    }
  }
}

test "webp_decode handles color indexing transform" {
  let encoded : Array[Byte] = [
    0x52, 0x49, 0x46, 0x46, 0x38, 0x00, 0x00, 0x00, 0x57, 0x45, 0x42, 0x50,
    0x56, 0x50, 0x38, 0x4C, 0x2C, 0x00, 0x00, 0x00, 0x2F, 0x3F, 0xC0, 0x0F,
    0x00, 0x20, 0xD2, 0xB6, 0x99, 0x7F, 0xD3, 0x87, 0x15, 0x70, 0x32, 0xFF,
    0xF3, 0xDF, 0xFF, 0x09, 0x28, 0x1E, 0x9C, 0xBC, 0xF8, 0xBF, 0x06, 0x27,
    0x2F, 0x2E, 0xFE, 0xAF, 0xE4, 0xC5, 0xC5, 0x83, 0xFF, 0x6B, 0x71, 0xF1,
    0xE0, 0xE4, 0xFF, 0x02,
  ]
  let decoded = webp_decode(encoded).unwrap()
  assert_eq((decoded.width, decoded.height), (64, 64))
  assert_eq((decoded.data[0], decoded.data[1], decoded.data[2], decoded.data[3]), (b'\xFF', b'\x00', b'\x00', b'\xFF'))
  let i = (16 * 64 + 16) * 4
  assert_eq((decoded.data[i], decoded.data[i + 1], decoded.data[i + 2], decoded.data[i + 3]), (b'\x00', b'\x00', b'\xFF', b'\xFF'))
}
