///|
/// Generated by scripts/generate-av1-directional-tile-reference.py.
/// Actual partition/mode/angle syntax is recorded separately; exact native samples are from
/// unmodified dav1d decoders. Color RGBA follows nearest420 entry conversion.
fn av1_directional_tile_reference_expand(runs : Array[Int]) -> Array[Int] {
  let result : Array[Int] = []
  for i in 0..<(runs.length() / 2) {
    for _ in 0..<runs[i * 2 + 1] {
      result.push(runs[i * 2])
    }
  }
  result
}

///|
fn av1_directional_tile_reference_compare(
  stream : Array[Byte],
  avif : Array[Byte],
  width : Int,
  height : Int,
  depth : Int,
  runs : Array[Array[Int]],
) -> Unit raise {
  let frame = av1_decode_frame_planes(stream).unwrap()
  assert_eq(
    (frame.width, frame.height, frame.bit_depth),
    (width, height, depth),
  )
  assert_eq((frame.full_range, frame.matrix_coefficients), (true, 2))
  assert_eq(frame.planes.length(), 3)
  let planes = runs.map(av1_directional_tile_reference_expand)
  for plane in 0..<3 {
    assert_eq(av1_frame_crop(frame, plane), planes[plane])
  }
  let expected = av1_yuv420_highbd_to_rgba(
    width,
    height,
    planes[0],
    planes[1],
    planes[2],
    depth,
    full_range=true,
    matrix_coefficients=2,
  ).unwrap()
  let raw = av1_decode(stream).unwrap()
  let container = avif_decode_rgba(avif).unwrap()
  assert_eq(
    (raw.width, raw.height, container.width, container.height),
    (width, height, width, height),
  )
  for y in 0..<height {
    for x in 0..<width {
      assert_eq(raw.get_pixel(x, y), expected.get_pixel(x, y))
      assert_eq(container.get_pixel(x, y), expected.get_pixel(x, y))
    }
  }
}

