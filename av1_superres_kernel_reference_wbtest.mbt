// Unchanged original scalar AOM revision 8e7b6a567df174d795479b92b4ac766d271add73.
// Canonical uint16-LE output SHA256 0aa928684ccc5dc765a804e4f66aff0e56489176c569e773ee439380155de453.

///|
// Only input construction is shared; expected pixels and parameters are from C.
fn av1_superres_reference_case(
  index : Int,
  depth : Int,
  pattern : Int,
  seed : Int,
  stride : Int,
  available : Int,
  downscaled : Int,
  upscaled : Int,
  rows : Int,
  expected_step : Int,
  expected_x0 : Int,
  expected_crc : UInt,
  expected_pixels : Array[Int],
) -> Unit raise {
  let maximum = (1 << depth) - 1
  let source : Array[Int] = []
  for row in 0..<rows {
    for x in 0..<stride {
      source.push(
        if x >= available {
          65535
        } else if pattern == 1 {
          if (x + 2 * row + seed) % 4 < 2 {
            0
          } else {
            maximum
          }
        } else {
          (seed * 37 + x * 29 + row * 43 + x % 7 * x * 11 + row * x * 3) &
          maximum
        },
      )
    }
  }
  let before = source.copy()
  assert_eq(
    av1_superres_params(downscaled, upscaled),
    Some((expected_step, expected_x0)),
  )
  let actual = av1_superres_upscale_plane(
    source, stride, available, downscaled, upscaled, rows, depth,
  ).unwrap()
  assert_eq((index, actual.length()), (index, upscaled * rows))
  assert_eq(source, before)
  let packed : Array[Byte] = []
  for value in actual {
    assert_true(value >= 0 && value <= maximum)
    packed.push((value & 255).to_byte())
    packed.push((value >> 8).to_byte())
  }
  assert_eq((index, crc32(packed, 0, packed.length())), (index, expected_crc))
  if expected_pixels.length() > 0 {
    assert_eq((index, actual), (index, expected_pixels))
  }
}

