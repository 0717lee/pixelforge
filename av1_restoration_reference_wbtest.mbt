    b'\x40', b'\x75', b'\x03', b'\xBE', b'\x5C', b'\xFF', b'\x2C', b'\x0E', b'\x8B',
    b'\xCB', b'\x54', b'\x76', b'\x94', b'\xCC', b'\x78', b'\x9E', b'\x17', b'\x59',
    b'\xDD', b'\x33', b'\xD0', b'\x9C', b'\x1C', b'\x8E', b'\xBF', b'\xD3', b'\xB1',
    b'\x00', b'\x9D', b'\xE2', b'\x7C', b'\x4F', b'\x81', b'\x63', b'\x2E', b'\xB3',
    b'\xA6', b'\x35', b'\x29', b'\x67', b'\xD8', b'\x13', b'\x8E', b'\xEA', b'\x65',
    b'\x65', b'\xAC', b'\x87', b'\xB7', b'\xDF', b'\x6C', b'\x08', b'\xA0', b'\xEF',
    b'\xCA', b'\x4F', b'\xE2', b'\x80', b'\xB7', b'\xE5', b'\xC6', b'\x26', b'\xAD',
    b'\x62', b'\x65', b'\x2E', b'\x36', b'\x6F', b'\x70', b'\xF4', b'\xB7', b'\xA2',
    b'\xB7', b'\xBA', b'\x98', b'\x65', b'\x6A', b'\x2F', b'\x02',
  ]
  let seq = av1_sequence_info(stream).unwrap()
  assert_eq(seq.profile, 0)
  assert_eq(seq.reduced_still_picture_header, true)
  assert_eq((seq.width, seq.height), (97, 65))
  assert_eq(seq.bit_depth, 10)
  assert_eq(seq.monochrome, false)
  assert_eq((seq.subsampling_x, seq.subsampling_y), (true, true))
  assert_eq(seq.use_128x128_superblock, false)
  assert_eq(
    (seq.enable_superres, seq.enable_cdef, seq.enable_restoration),
    (true, true, true),
  )
  assert_eq(seq.full_range, true)
  let frames = av1_obu_payloads(stream, 6)
  assert_eq(frames.length(), 1)
  let frame = av1_parse_stage1_frame(
    frames[0],
    seq,
    allow_monochrome=true,
    allow_highbd=true,
  ).unwrap()
  assert_eq(
    (frame.frame_width, frame.upscaled_width, frame.superres_denom),
    (65, 97, 12),
  )
  assert_eq(frame.base_q_idx, 160)
  assert_eq(frame.disable_cdf_update, false)
  assert_eq(frame.allow_screen_content_tools, false)
  assert_eq(frame.coded_lossless, false)
  assert_eq((frame.tile_cols, frame.tile_rows), (1, 1))
  assert_eq(frame.tile_col_starts_sb, [0, 2])
  assert_eq(frame.tile_row_starts_sb, [0, 2])
  // tx_mode_select follows AOM read_tx_mode: raw bit 1 selects TX_MODE_SELECT.
  // The FFmpeg trace ordinal is ONLY_4X4=0/LARGEST=1/SELECT=2, where ordinal 1
  // is TX_MODE_LARGEST, not SELECT; this fixture's trace ordinal is 1.
  assert_eq((frame.tx_mode_select, frame.reduced_tx_set), (false, false))
  let cdef = frame.cdef.unwrap()
  assert_eq((cdef.bits, cdef.damping), (1, 5))
  assert_eq(cdef.y_primary, [0, 15])
  assert_eq(cdef.y_secondary, [0, 0])
  assert_eq(cdef.uv_primary, [6, 0])
  assert_eq(cdef.uv_secondary, [4, 1])
  let restoration = frame.restoration.unwrap()
  assert_eq(restoration.modes, [
    Av1RestorationWiener,
    Av1RestorationWiener,
    Av1RestorationWiener,
  ])
  assert_eq(restoration.unit_sizes, [128, 128, 128])
  assert_eq(av1_restoration_active(restoration), true)
  let layout = av1_restoration_layout(
    restoration, 65, 97, 65, false, true, true, 12,
  ).unwrap()
  assert_eq(layout.unit_cols, [1, 1, 1])
  assert_eq(layout.unit_rows, [1, 1, 1])
}
