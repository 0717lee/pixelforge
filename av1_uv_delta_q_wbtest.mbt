///|
fn av1_uvdq_deltas(stream : Array[Byte]) -> (Int, Av1QuantDeltas) {
  let seq = av1_sequence_info(stream).unwrap()
  let frames = av1_obu_payloads(stream, 6)
  let frame = av1_parse_stage1_frame(frames[0], seq).unwrap()
  (frame.base_q_idx, frame.quant_deltas)
}

///|
/// The rewritten stream carries the diff flag and an independent V pair.
test "separate uv delta q parses an independent V delta pair" {
  let (base, deltas) = av1_uvdq_deltas(av1_uvdq_stream_separate())
  assert_eq(base, 32)
  assert_eq(deltas.y_dc, 0)
  assert_eq(deltas.u_dc, 2)
  assert_eq(deltas.u_ac, 2)
  assert_eq(deltas.v_dc, 5)
  assert_eq(deltas.v_ac, -3)
}

///|
/// Without the flag V simply mirrors U.
test "shared uv delta q mirrors the U deltas onto V" {
  let (base, deltas) = av1_uvdq_deltas(av1_uvdq_stream_shared())
  assert_eq(base, 32)
  assert_eq(deltas.u_dc, 2)
  assert_eq(deltas.u_ac, 2)
  assert_eq(deltas.v_dc, deltas.u_dc)
  assert_eq(deltas.v_ac, deltas.u_ac)
}

///|
/// Per-plane quantizer index arithmetic (AV1 7.12.3): luma AC keeps the base
/// index and every other index adds its delta before the [0, 255] clamp.
test "plane qindex applies the deltas and clamps" {
  let deltas : Av1QuantDeltas = {
    y_dc: 3,
    u_dc: 2,
    u_ac: 2,
    v_dc: 5,
    v_ac: -3,
  }
  assert_eq(av1_plane_qindex(32, deltas, 0, true), 35)
  assert_eq(av1_plane_qindex(32, deltas, 0, false), 32)
  assert_eq(av1_plane_qindex(32, deltas, 1, true), 34)
  assert_eq(av1_plane_qindex(32, deltas, 1, false), 34)
  assert_eq(av1_plane_qindex(32, deltas, 2, true), 37)
  assert_eq(av1_plane_qindex(32, deltas, 2, false), 29)
  assert_eq(av1_plane_qindex(1, deltas, 2, false), 0)
  assert_eq(av1_plane_qindex(253, deltas, 0, true), 255)
}

///|
/// End-to-end against dav1d: the stream with non-zero U deltas decodes
/// exactly, including the chroma planes whose dequant no longer uses the
/// luma index.
test "shared uv delta q stream matches dav1d pixel truth" {
  let frame = av1_decode_frame_planes(av1_uvdq_stream_shared()).unwrap()
  let y = av1_frame_crop(frame, 0)
  let u = av1_frame_crop(frame, 1)
  let v = av1_frame_crop(frame, 2)
  assert_eq(av1_plane_digest(y), 1288596)
  assert_eq(av1_plane_digest(u), 13048412)
  assert_eq(av1_plane_digest(v), 2383940)
  assert_eq(v[0], 96)
  assert_eq(v[1], 99)
  assert_eq(v[2], 102)
  assert_eq(v[3], 105)
}

///|
/// The same picture with an independent V pair: Y and U are unchanged and V
/// follows the new index, which no shared-delta code path can reproduce.
test "separate uv delta q stream matches dav1d pixel truth" {
  let frame = av1_decode_frame_planes(av1_uvdq_stream_separate()).unwrap()
  let y = av1_frame_crop(frame, 0)
  let u = av1_frame_crop(frame, 1)
  let v = av1_frame_crop(frame, 2)
  assert_eq(av1_plane_digest(y), 1288596)
  assert_eq(av1_plane_digest(u), 13048412)
  assert_eq(av1_plane_digest(v), 11314441)
  assert_eq(v[0], 98)
  assert_eq(v[1], 100)
  assert_eq(v[2], 104)
  assert_eq(v[3], 106)
}
