// Oracle: unmodified inv_txfm2d_add_c + cfg/stage/flip functions + original 1D kernels.
// Boundary: replace final highbd_clip_pixel_add with a signed residual recording sink.
// Transpose row-major coefficients to upstream column-major input; retain all residuals.
// Normal coefficient range-check build flags; original explicit clamps remain active.
// 336 asymmetric cases + 112 bounded 12-bit stress cases; 16 types x 7 geometries.
// av1_inv_txfm2d.c SHA-256: 2956712253cd0a546ac8c4a1431322cee39538d6991fc25d0891090bc0f2be08
// av1_inv_txfm1d.c SHA-256: a4b9699340740844f1ad486e2d696ce52fd62f15d242b3203e54b71046bc4b07
// av1_inv_txfm1d_cfg.h SHA-256: bc8c410ea1492ccaaa8ded42bfe6aa52b66ea004a4790afde2769103325eb925
// av1_inv_txfm1d.h SHA-256: 076be6972bb19f58bf3ad85b4118a05a327e4b4548ee8d5167eb51b49d126ed6
// av1_txfm.h SHA-256: af3bcaae01687bb47cb82386b619b6534962fe4c187e5bda54439d42071e5aad
// av1_txfm.c SHA-256: b5e16fad02ab634226ad1e10e9ea55ac6132aad376f70de710108f2f73b9035b
// enums.h SHA-256: d5fe41da228fb0bbb303776024971f2cb2c81e4231aa9e75c244578cd9f0ffb5
// common_data.h SHA-256: 8561eb7066fa5f49a2d74c5ec9b8e7ed6dff93254414997f7497863dd1aa4938
// txfm_common.h SHA-256: 2bb0a38e0b5d5358f463f5f652b59fa8859f206f0355c0b66895801851b4b983

///|
// Input generation only; expected residuals come from the original C kernels.
fn transform_reference_coefficients(
  width : Int,
  height : Int,
  bit_depth : Int,
  stress : Bool,
) -> Array[Int] {
  let values : Array[Int] = []
  for y in 0..<height {
    for x in 0..<width {
      let value = if stress && ((x * 3 + y * 5) % 11 == 0 || (y == 0 && x == 2)) {
        let magnitude = 450000 - (x * 733 + y * 941) % 40000
        if (x + y) % 2 == 0 {
          magnitude
        } else {
          -magnitude
        }
      } else {
        ((x * 37 + y * 53 + x * y * 11) % 257 - 128) * (1 << (bit_depth - 8)) +
        (x + 3 * y) % 5 -
        2
      }
      values.push(value)
    }
  }
  values
}

///|
fn transform_reference_residual(hex : String) -> Array[Int] {
  let values : Array[Int] = []
  for i in 0..<(hex.length() / 4) {
    let mut value = 0
    for j in 0..<4 {
      let code = hex[i * 4 + j].to_int()
      value = value * 16 + (if code <= 57 { code - 48 } else { code - 87 })
    }
    values.push(if value < 32768 { value } else { value - 65536 })
  }
  values
}

///|
test "av1 libaom all transform residuals 4x4 8-bit asymmetric" {
  let width = 4
  let height = 4
  let bit_depth = 8
  let input = transform_reference_coefficients(width, height, bit_depth, false)
  let types : Array[Av1TxType] = [
    Av1TxDctDct,
    Av1TxAdstDct,
    Av1TxDctAdst,
    Av1TxAdstAdst,
    Av1TxFlipadstDct,
    Av1TxDctFlipadst,
    Av1TxFlipadstFlipadst,
    Av1TxAdstFlipadst,
    Av1TxFlipadstAdst,
    Av1TxIdentityIdentity,
    Av1TxVerticalDct,
    Av1TxHorizontalDct,
    Av1TxVerticalAdst,
    Av1TxHorizontalAdst,
    Av1TxVerticalFlipadst,
    Av1TxHorizontalFlipadst,
  ]
  let expected : Array[String] = [
    "fff7fff9fff7fffbfff1fff100050002fff800070009fff6fff90002fff50006", "fffefffefff6fffcfff2ffee00010002fff50002000afff5fff60001fff60005",
    "fffbfffafff6fff9fff6ffecfffffffffff60003000afff7fffa0002fff40004", "00000001fff6fffafff9ffebfffbfffffff4fffd000afff5fff70000fff40002",
    "fff60001fff60005fff50002000afff5fff2ffee00010002fffefffefff6fffc", "fff9fff6fffafffbffffffffffecfff6fff7000a0003fff60004fff40002fffa",
    "0002fff40000fff7fff5000afffdfff4fffffffbffebfff9fffafff600010000", "fffafff600010000fffffffbffebfff9fff5000afffdfff40002fff40000fff7",
    "fff70000fff40002fff4fffd000afff5fff9ffebfffbffff00000001fff6fffa", "fff0fff5fff9fffefff7fffd00020009fffd0005000cfff40004000cfff5fffe",
    "fff2fffe0001fffefff4ffeffffe0009ffff0001ffef0002fffbfffb0004fff4", "ffecfff9fffdfffdfffdfff40001fffc00040002ffef00050004000c0003fff5",
    "fff700040003fffbfff2fff000030008fffbfffeffef0005fff9fff90002fff5", "fff0fff5fff9fffa0001fff4fffefffb00050007fff000030000000d0008fff7",
    "fff9fff90002fff5fffbfffeffef0005fff2fff000030008fff700040003fffb", "fffafff9fff5fff0fffbfffefff400010003fff000070005fff70008000d0000",
  ]
  for index in 0..<types.length() {
    let actual = av1_inverse_transform_2d(
      types[index],
      input,
      width,
      height,
      bit_depth,
    ).unwrap()
    assert_eq(
      (index, actual),
      (index, transform_reference_residual(expected[index])),
    )
  }
}

