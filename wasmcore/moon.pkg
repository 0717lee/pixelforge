// Genuine-WebAssembly bindings: wraps the PixelForge core and links a
// linear-memory wasm module that exports its `memory` for bulk pixel transfer.
import {
  "0717lee/pixelforge",
}

pkgtype(kind: "foreign_library")

options(
  link: {
    "wasm": {
      "exports": [ "alloc", "process", "process_in_place" ],
      "export-memory-name": "memory",
    },
  },
)
