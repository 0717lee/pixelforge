      "00508e0000bc0340ec06b0070c00450000fe08101912c0a907503200a0000f90b208504901100701600a00d00600212a00a00901103305907e0950b30d811401106f0720950510620820ff01f0a00b80ab0d410c0320e301a0cb05d08a05b0a9",
      12,
    ),
  )
  assert_eq(
    vf,
    cdef_reference_pixels(
      "f35ffff4fecafa5ef6fddf3bec1fbef54ef8fecf88f34fecfe8fa4f5df44f08ff8ff2fd2f7ff73f7df71f4bf46f4ef32f40f59f74fa4fc3fe0ff2ffceecf26f79fd8fa2f7df81f83feaf0df89feff9afa0faaf7df9ceddf89ff4fb6fd4fb6fe9",
      12,
    ),
  )
}

///|
test "cdef libaom YUV420 reference 12-bit direction 5" {
  let y = cdef_reference_input(13, 11, 12, 219)
  let u = cdef_reference_input(7, 6, 12, 220)
  let v = cdef_reference_input(7, 6, 12, 221)
  let y_params : Array[Av1CdefParams] = [
    { primary_strength: 15, secondary_strength: 0, damping: 3, direction: 5, },
    { primary_strength: 0, secondary_strength: 1, damping: 4, direction: 6, },
    { primary_strength: 2, secondary_strength: 2, damping: 5, direction: 7, },
    { primary_strength: 1, secondary_strength: 4, damping: 6, direction: 0, },
  ]
  let uv_params : Array[Av1CdefParams] = [
    { primary_strength: 7, secondary_strength: 1, damping: 3, direction: 5, },
    { primary_strength: 8, secondary_strength: 2, damping: 4, direction: 7, },
    { primary_strength: 0, secondary_strength: 4, damping: 5, direction: 1, },
    { primary_strength: 15, secondary_strength: 0, damping: 6, direction: 3, },
  ]
  let (yf, uf, vf) = av1_cdef_filter_yuv420(
    13,
    11,
    y,
    u,
    v,
    y_params,
    uv_params,
    bit_depth=12,
  ).unwrap()
  assert_eq(
    yf,
    cdef_reference_pixels(
      "",
      12,
    ),
  )
  assert_eq(
    uf,
    cdef_reference_pixels(
      "13b0880000ed0361060820cd06700210109102713509004100d14210b0b609802001b00f00a00d15515714300701804407505a0440fa12e01b0740a50e30f1",
      12,
    ),
  )
  assert_eq(
    vf,
    cdef_reference_pixels(
      "f3cff7f64ffffa6f07fefed5fd5f6ff0dff3f9ef3effafa7f6bf58f25ff2f8ff86f89f7ff67f69f65ed9f5bf6af7bf5df5bf85f9eff9f45f7ef7df8befaf0d",
      12,
    ),
  )
}

