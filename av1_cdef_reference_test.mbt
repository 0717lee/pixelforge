    "0ee05300c0b202e0c505e10309803700b0d805d01e0f309904f01a00f10f0d907a0850590210100091311101071010fe0fc11f00902b06508008b09d0bd1050110430960d712a05a0670dd00a07c1020490470850270c300e09d14a09d0e3055",
    "f27fbaf4dfd6f8ef02f9cf47fcafabf46f16fabf58f53fbbfb6f61f59f3cfb8faaf8efa0f6cf69f3cf5af83f69f79f4bf5ff40f5ff80fa0fb1f52f70fc7f55f70f7bfb2fb7f2cf12fbefcff6efaeeddf64f65ef5f91fe6f7af9cef7f73f25f91",
    "7f67a68407ea85181888981f7fd8758588017da81a8517f688286e83f8417f381481180d87a85984281d8348068107c683684584585181f82182679682381482e84479b7e57d47e08297b882e8447c87ec7997bf8317868047857c87817de77c",
  ]
  let mut index = 0
  for direction in 0..<8 {
    for primary_strength in [7, 8] {
      for secondary_strength in [0, 1, 2, 4] {
        for damping in 3..<7 {
          let input = cdef_reference_input(
            8,
            8,
            bit_depth,
            bit_depth * 101 + index,
          )
          let params : Array[Av1CdefParams] = [
            { primary_strength, secondary_strength, damping, direction, },
          ]
          let actual = av1_cdef_filter_plane(8, 8, input, params, bit_depth~).unwrap()
          assert_eq(
            (index, actual),
            (index, cdef_reference_pixels(expected[index], bit_depth)),
          )
          index += 1
        }
      }
    }
  }
}

///|
test "cdef libaom border reference 8-bit 1x1" {
  let input = cdef_reference_input(1, 1, 8, 248)
  let params : Array[Av1CdefParams] = [
    { primary_strength: 15, secondary_strength: 4, damping: 6, direction: 0, },
  ]
  let actual = av1_cdef_filter_plane(1, 1, input, params, bit_depth=8).unwrap()
  assert_eq(actual, cdef_reference_pixels("f7", 8))
}

