/// Generated by _refs/mc_sim.py.
///
/// Eight-tap subpel motion compensation vectors, produced by a Python
/// transcription of AV1 7.11.3.4 written independently of the MoonBit kernel.
/// Each vector names its filter set, block geometry, subsampling and rounding
/// mode, so a precedence slip or an off-by-one in the intermediate buffer
/// breaks a case rather than being mirrored by both implementations.

///|
/// Build a stored reference frame from one plane's worth of samples. The other
/// two planes mirror it so a chroma request has the same layout to read.
fn av1_mc_test_frame(
  samples : Array[Int],
  width : Int,
  height : Int,
  chroma_width : Int,
  chroma_height : Int,
  bit_depth : Int,
  plane : Int,
) -> Av1RefFrame {
  let coded_width = av1_partition_coded_extent(width)
  let coded_height = av1_partition_coded_extent(height)
  let chroma_coded = (
      (coded_width + 1) >> (if chroma_width == width { 0 } else { 1 })
    ) *
    ((coded_height + 1) >> (if chroma_height == height { 0 } else { 1 }))
  // Only the plane under test carries samples; the others stay zero-filled at
  // their own extent so an accidental cross-plane read cannot alias.
  let planes : Array[Array[Int]] = if plane == 0 {
    let luma : Array[Int] = Array::make(coded_width * coded_height, 0)
    for y in 0..<height {
      for x in 0..<width {
        luma[y * coded_width + x] = samples[y * width + x]
      }
    }
    [luma, Array::make(chroma_coded, 0), Array::make(chroma_coded, 0)]
  } else {
    [
      Array::make(coded_width * coded_height, 0),
      Array::copy(samples),
      Array::copy(samples),
    ]
  }
  {
    planes,
    coded_width,
    coded_height,
    width,
    height,
    sub_x: if chroma_width == width {
      0
    } else {
      1
    },
    sub_y: if chroma_height == height {
      0
    } else {
      1
    },
    bit_depth,
    frame_width: width,
    upscaled_width: width,
    frame_height: height,
    render_width: width,
    render_height: height,
    order_hint: 0,
    frame_type: av1_key_frame,
    frame_id: 0,
    order_hints: Array::make(av1_total_refs_per_frame, 0),
    gm_params: Array::make(av1_total_refs_per_frame, av1_identity_gm_params()),
    loop_filter_ref_deltas: av1_default_loop_filter_ref_deltas(),
    loop_filter_mode_deltas: [0, 0],
  }
}

