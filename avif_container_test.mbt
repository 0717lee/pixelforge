'\x00', b'\x00', b'\x00', b'\x00', b'\x03', b'\x08', b'\x08', b'\x08', b'\x00', b'\x00', b'\x00', b'\x0C', b'\x61', b'\x76', b'\x31', b'\x43', b'\x81', b'\x20', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x13', b'\x63', b'\x6F', b'\x6C', b'\x72', b'\x6E', b'\x63', b'\x6C', b'\x78', b'\x00', b'\x02', b'\x00', b'\x02', b'\x00', b'\x00', b'\x80', b'\x00', b'\x00', b'\x00', b'\x17', b'\x69', b'\x70', b'\x6D', b'\x61', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x01', b'\x00', b'\x01', b'\x04', b'\x01', b'\x02', b'\x83', b'\x04', b'\x00', b'\x00', b'\x00', b'\x40', b'\x6D', b'\x64', b'\x61', b'\x74', b'\x0A', b'\x07', b'\x38', b'\x00', b'\x36', b'\xD0', b'\x10', b'\xD0', b'\x02', b'\x32', b'\x2D', b'\x10', b'\x00', b'\x00', b'\x40', b'\x7F', b'\x30', b'\x24', b'\x03', b'\x50', b'\x96', b'\x14', b'\xA4', b'\xD2', b'\x93', b'\x4A', b'\x4E', b'\x4D', b'\x28', b'\x3F', b'\xFF', b'\xEB', b'\x66', b'\x2F', b'\x9B', b'\x70', b'\x7D', b'\xC1', b'\xF7', b'\x08', b'\x06', b'\x64', b'\x41', b'\xFF', b'\xC6', b'\xF8', b'\xC7', b'\xA7', b'\x86', b'\x12', b'\x89', b'\x4A', b'\x25', b'\x28', b'\x9C', b'\x70']
  let parsed = avif_container_parse(data).unwrap()
  assert_eq((parsed.width, parsed.height), (2, 2))
  assert_eq(parsed.av1c.length(), 4)
  assert_true(parsed.payload.length() > 8)
  assert_false(parsed.has_alpha)
}

///|
test "avif container rejects truncation" {
  let data : Array[Byte] = [b'\x00', b'\x00', b'\x00', b'\x20', b'f', b't', b'y', b'p']
  assert_true(avif_container_parse(data) is None)
}
