///|
// Input is one of the thirteen AV1 intra modes, numbered 0 through 12.
fn av1_intra_mode_context(mode : Int) -> Int {
  let contexts : Array[Int] = [0, 1, 2, 3, 4, 4, 4, 4, 3, 0, 1, 2, 0]
  contexts[mode]
}
