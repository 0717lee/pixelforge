    1, 130, 2, 129, 1, 126, 1, 124, 1, 119, 1, 121, 1, 123, 1, 128, 1, 136, 1, 139,
    1, 136, 1, 133, 1, 120, 1, 114, 1, 113, 1, 121, 1, 129, 2, 130, 2, 121, 1, 119,
    1, 120, 1, 126, 1, 134, 1, 137, 1, 132, 1, 127, 2, 129, 1, 130, 1, 131, 2, 130,
    1, 127, 1, 125, 1, 121, 2, 123, 1, 128, 1, 136, 1, 139, 1, 136, 1, 133, 1, 119,
    1, 110, 1, 111, 1, 121, 1, 129, 2, 128, 1, 132, 1,
  ])
  let expected = av1_yuv420_highbd_to_rgba(
    64,
    64,
    y,
    u,
    v,
    8,
    full_range=false,
    matrix_coefficients=2,
  ).unwrap()
  assert_true(avif_grid_descriptor(container) is None)
  assert_true(avif_decode_grid_auto(container) is None)
  for
    actual in [
      avif_decode(container).unwrap(),
      avif_decode_rgba(container).unwrap(),
    ] {
    assert_eq((actual.width, actual.height), (64, 64))
    for y in 0..<64 {
      for x in 0..<64 {
        assert_eq(
          (x, y, actual.get_pixel(x, y)),
          (x, y, expected.get_pixel(x, y)),
        )
      }
    }
  }
}

