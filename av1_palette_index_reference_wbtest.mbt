test "original AOM palette index N3 Y adaptive four maps" {
  let stream = av1_palette_index_reference_bytes([
    "581ed90ea0fc6df1f86e78ca999217204de458c4d2dea33681e3cc6bc65cbcc379aa21b0e387790e78ec125eb99f8812",
    "e540516058a510fbac4d1549264fa4fb5ac8570c0d343c0e9f029fdd5d3343735d8a7016bc8f24f409a315c88fe3cedb",
    "c7c22511f41413f77470063ea1bf8dccfb76f9869117ee896e660190f42ff68aad2d6ff19139db3a0398e162eaf18509",
    "b4f567cc820df6e00d3ee772861538b526c1b5921d417b5cc92fe0f047628869558f5722f818340e569f010a8cf2a61c",
    "e69ff7e2d03e39d2631d5b8018583275a41d24e9f631c3c7135bc733d90a7767fdd5b4ccc4d7f275a3a56eeadf9d9a20",
    "f360903c42b969b955667251a30e29ae44a518f4842959d8c1e22ebbd5ad419693f82658f6f06d706ec74cc3249cf4d6",
    "3783565d55f5cee0",
  ])

  let decoder = av1_msac_new(stream, true)
  let state = av1_palette_state(8, 8)
  let cdfs = state.y_index[1]

  assert_eq(cdfs[0], [27877, 30490, 32768, 0])

  assert_eq(cdfs[1], [11532, 25697, 32768, 0])

  assert_eq(cdfs[2], [6544, 30234, 32768, 0])

  assert_eq(cdfs[3], [23018, 28072, 32768, 0])

  assert_eq(cdfs[4], [31915, 32385, 32768, 0])

  let actual_0 = av1_palette_decode_index_map(decoder, 3, 8, 8, 8, 8, cdfs).unwrap()

  let expected_0 = av1_palette_index_reference_bytes([
    "000001010201000200010000000002000002000100010102020202020001000000010101020201000000020001010102",
    "00020001020101000001010102000202",
  ])

  assert_eq(actual_0.length(), expected_0.length())
  for i in 0..<actual_0.length() {
    assert_eq((i, actual_0[i]), (i, expected_0[i].to_int()))
  }

  assert_eq(av1_palette_literal(decoder, 16), 42451)

  assert_eq(cdfs[0], [20772, 25915, 32768, 14])

  assert_eq(cdfs[1], [11676, 23705, 32768, 14])

  assert_eq(cdfs[2], [8006, 22700, 32768, 20])

  assert_eq(cdfs[3], [18150, 25261, 32768, 9])

  assert_eq(cdfs[4], [23718, 30706, 32768, 6])

  let actual_1 = av1_palette_decode_index_map(decoder, 3, 32, 16, 16, 24, cdfs).unwrap()

  let expected_1 = av1_palette_index_reference_bytes([
    "020001010202020101010201010001010002010002020100000000000000000000010000020101020202000101010102",
    "010101020000000202020202020202020002000002000101000200010102000201020002020100010101010101010101",
    "010102000000020101010201000101000101010002020101010101010101010101000102000202000001020200020200",
    "020202020100020202020202020202020102020102000102020202020202010002020100020101010101010101010101",
    "010001020202020202000002000002000001000101010200000000000000000001010201000201010102010001010100",
    "010201000100020202020202020202020201010100010201020002010001020200020001020200000000000000000000",
    "010202020000000100010102010202000101010102020201010101010101010100020002010202000202010100010100",
    "000102020002020202020202020202020001020001010000010001010000000001000000020002010101010101010101",
    "010201020200000100020000020101010102010101010001010101010101010101000200010102010100000201020200",
    "020200000102020101010101010101010002000000020000020100000102020101010102000200010101010101010101",
    "0002010202000002020001000100000102000202020002020202020202020202",
  ])

  assert_eq(actual_1.length(), expected_1.length())
  for i in 0..<actual_1.length() {
    assert_eq((i, actual_1[i]), (i, expected_1[i].to_int()))
  }

  assert_eq(av1_palette_literal(decoder, 16), 42451)

  assert_eq(cdfs[0], [16574, 24801, 32768, 32])

  assert_eq(cdfs[1], [9917, 22347, 32768, 32])

  assert_eq(cdfs[2], [10103, 20997, 32768, 32])

  assert_eq(cdfs[3], [11455, 23226, 32768, 32])

  assert_eq(cdfs[4], [12869, 21470, 32768, 32])

  let actual_2 = av1_palette_decode_index_map(decoder, 3, 16, 32, 24, 16, cdfs).unwrap()

  let expected_2 = av1_palette_index_reference_bytes([
    "010001010200020100020100000101000001000002020200010201010100000000020002020201020002020001020100",
    "000101020202000100000001000000000100020001000100010100020201010100020001010102020000020101000101",
    "020200010001010102020100010100010000020002010100000102020000000100010000010201010100020200020001",
    "010202010002000001000100020202000002000202020202010002000001010201000000020000020000000101010000",
    "010201000002000100010202000201020000010002000101000102020202020001020001010102020202020000010001",
    "010100000101010102000102020201000001000201020000000101010000020201020202010201010101000002020101",
    "020100020002000101020002020100020100010101010202020000010200000001020001000200010000020102000202",
    "020200000200020000000002000200020002000002000202010002020202010101000202000002010200010202020200",
    "010002020000020102000102020202000100020200000201020001020202020001000202000002010200010202020200",
    "010002020000020102000102020202000100020200000201020001020202020001000202000002010200010202020200",
    "0100020200000201020001020202020001000202000002010200010202020200",
  ])

  assert_eq(actual_2.length(), expected_2.length())
  for i in 0..<actual_2.length() {
    assert_eq((i, actual_2[i]), (i, expected_2[i].to_int()))
  }

  assert_eq(av1_palette_literal(decoder, 16), 42451)

  assert_eq(cdfs[0], [12579, 24850, 32768, 32])

  assert_eq(cdfs[1], [10527, 21892, 32768, 32])

  assert_eq(cdfs[2], [10433, 22188, 32768, 32])

  assert_eq(cdfs[3], [11669, 22414, 32768, 32])

  assert_eq(cdfs[4], [12234, 21107, 32768, 32])

  let actual_3 = av1_palette_decode_index_map(decoder, 3, 32, 32, 24, 24, cdfs).unwrap()

  let expected_3 = av1_palette_index_reference_bytes([
    "010001010202010201020001010100000002010200020102020202020202020200010000020002000002010201010201",
    "010001000100020202020202020202020002000202010100010201020002020102010002010200020202020202020202",
    "000101010202010200000202010001010002020102010100000000000000000000000200020001020000020200020201",
    "000102010101020000000000000000000001020001020100010101010002020101000000000101000000000000000000",
    "000000020001020102020002000100000000010101020201010101010101010100020000010102000101000202010102",
    "000002010201010000000000000000000102020201000102010001010001000000010002020100000000000000000000",
    "000102010101020000010201000000010202010000000102020202020202020202020000000001010202010102020200",
    "010002020202000101010101010101010102000202000200000100000102020000010001000001020202020202020202",
    "010101010200000202010000000201010202010001000202020202020202020200020000010102010202000102020102",
    "010001020200000000000000000000000001020201000100010102000000020201010101010002010101010101010101",
    "000002010202010202010200020000020100000000020101010101010101010101020002000202020202010102000101",
    "000202020202000000000000000000000002020000000202020100000101020201010201020200000000000000000000",
    "010202000100000201020100010002010001020201020000000000000000000002010102010200020001020101010101",
    "010000020100020000000000000000000100000101010202010002020002020000020201020202020202020202020202",
    "000100020102020102000002020200000100020200000001010101010101010102000201010101010200020201010100",
    "020000000202000202020202020202020201020000010102010100020000000100010101010202010101010101010101",
    "020102000001010201010002000000010001010101020201010101010101010102010200000101020101000200000001",
    "000101010102020101010101010101010201020000010102010100020000000100010101010202010101010101010101",
    "020102000001010201010002000000010001010101020201010101010101010102010200000101020101000200000001",
    "000101010102020101010101010101010201020000010102010100020000000100010101010202010101010101010101",
    "020102000001010201010002000000010001010101020201010101010101010102010200000101020101000200000001",
    "00010101010202010101010101010101",
  ])

  assert_eq(actual_3.length(), expected_3.length())
  for i in 0..<actual_3.length() {
    assert_eq((i, actual_3[i]), (i, expected_3[i].to_int()))
  }

  assert_eq(av1_palette_literal(decoder, 16), 42451)

  assert_eq(cdfs[0], [11553, 22550, 32768, 32])

  assert_eq(cdfs[1], [10277, 19905, 32768, 32])

  assert_eq(cdfs[2], [12019, 25678, 32768, 32])

  assert_eq(cdfs[3], [10804, 21725, 32768, 32])

  assert_eq(cdfs[4], [10340, 20279, 32768, 32])

  assert_eq(decoder.allow_update, true)
  assert_true(decoder.symbol_max_bits >= -14)
}

///|
test "original AOM palette index N3 UV frozen four maps" {
  let stream = av1_palette_index_reference_bytes([
    "438522aa1df39432586b06d96e99e62a719d11c92049bc61dff3e19485c1964272fccab5f987512449e75739a251f942",
    "71571ce5693caadb5bce82de6b2ac1039cba6cf0bee340c792d1c7d2461db06de8e652e36fca29910b5a50aa0be4aeac",
    "02",
  ])

  let decoder = av1_msac_new(stream, false)
  let state = av1_palette_state(8, 8)
  let cdfs = state.uv_index[1]

  assert_eq(cdfs[0], [25257, 29145, 32768, 0])

  assert_eq(cdfs[1], [12287, 27293, 32768, 0])

  assert_eq(cdfs[2], [7033, 27960, 32768, 0])

  assert_eq(cdfs[3], [20145, 25405, 32768, 0])

  assert_eq(cdfs[4], [30608, 31639, 32768, 0])

  let actual_0 = av1_palette_decode_index_map(decoder, 3, 4, 4, 4, 4, cdfs).unwrap()

  let expected_0 = av1_palette_index_reference_bytes([
    "00000101000100020002000102010201",
  ])

  assert_eq(actual_0.length(), expected_0.length())
  for i in 0..<actual_0.length() {
    assert_eq((i, actual_0[i]), (i, expected_0[i].to_int()))
  }

  assert_eq(av1_palette_literal(decoder, 16), 42451)

  assert_eq(cdfs[0], [25257, 29145, 32768, 0])

  assert_eq(cdfs[1], [12287, 27293, 32768, 0])

  assert_eq(cdfs[2], [7033, 27960, 32768, 0])

  assert_eq(cdfs[3], [20145, 25405, 32768, 0])

  assert_eq(cdfs[4], [30608, 31639, 32768, 0])

  let actual_1 = av1_palette_decode_index_map(decoder, 3, 16, 8, 8, 12, cdfs).unwrap()

  let expected_1 = av1_palette_index_reference_bytes([
    "020001010200020001020001010101010001000202010200020102020202020200020001000201010200000101010101",
    "020102020002000000000002020202020102010201020101000001010101010102000001000202010101000000000000",
    "0002010000010000010201010101010100020100020001010100000000000000",
  ])

  assert_eq(actual_1.length(), expected_1.length())
  for i in 0..<actual_1.length() {
    assert_eq((i, actual_1[i]), (i, expected_1[i].to_int()))
  }

  assert_eq(av1_palette_literal(decoder, 16), 42451)

  assert_eq(cdfs[0], [25257, 29145, 32768, 0])

  assert_eq(cdfs[1], [12287, 27293, 32768, 0])

  assert_eq(cdfs[2], [7033, 27960, 32768, 0])

  assert_eq(cdfs[3], [20145, 25405, 32768, 0])

  assert_eq(cdfs[4], [30608, 31639, 32768, 0])

  let actual_2 = av1_palette_decode_index_map(decoder, 3, 8, 16, 12, 8, cdfs).unwrap()

  let expected_2 = av1_palette_index_reference_bytes([
    "010001010202000200010002020002010002000100010001010102020102010102010200010202020201010200020200",
    "010101020202000102020001020201020001000100010000000101020000010101000002020000000000000000010102",
    "0000000000010102000000000001010200000000000101020000000000010102",
  ])

  assert_eq(actual_2.length(), expected_2.length())
  for i in 0..<actual_2.length() {
    assert_eq((i, actual_2[i]), (i, expected_2[i].to_int()))
  }

  assert_eq(av1_palette_literal(decoder, 16), 42451)

  assert_eq(cdfs[0], [25257, 29145, 32768, 0])

  assert_eq(cdfs[1], [12287, 27293, 32768, 0])

  assert_eq(cdfs[2], [7033, 27960, 32768, 0])

  assert_eq(cdfs[3], [20145, 25405, 32768, 0])

  assert_eq(cdfs[4], [30608, 31639, 32768, 0])

  let actual_3 = av1_palette_decode_index_map(decoder, 3, 16, 16, 12, 12, cdfs).unwrap()

  let expected_3 = av1_palette_index_reference_bytes([
    "010001010201020200010001010101010001000000010201020000000000000000020000010202000100010202020202",
    "000202020102020102000202020202020002000101000200020202000000000001000200010102010101000000000000",
    "010101020001010102010000000000000202020202010002000201010101010102010000010202020001000000000000",
    "020001010200010002020201010101010202020100020202000100010101010101010101020201010200000101010101",
    "010101010202010102000001010101010101010102020101020000010101010101010101020201010200000101010101",
    "01010101020201010200000101010101",
  ])

  assert_eq(actual_3.length(), expected_3.length())
  for i in 0..<actual_3.length() {
    assert_eq((i, actual_3[i]), (i, expected_3[i].to_int()))
  }

  assert_eq(av1_palette_literal(decoder, 16), 42451)

  assert_eq(cdfs[0], [25257, 29145, 32768, 0])

  assert_eq(cdfs[1], [12287, 27293, 32768, 0])

  assert_eq(cdfs[2], [7033, 27960, 32768, 0])

  assert_eq(cdfs[3], [20145, 25405, 32768, 0])

  assert_eq(cdfs[4], [30608, 31639, 32768, 0])

  assert_eq(decoder.allow_update, false)
  assert_true(decoder.symbol_max_bits >= -14)
}

///|
test "original AOM palette index N3 UV adaptive four maps" {
  let stream = av1_palette_index_reference_bytes([
    "45ce0d8149f632326850defe714e57715d8730ae1adc708f8d29cbbf5fe0f80cf4005bcc7a8b72ed33c8d7a09f06778c",
    "27743861d093476995ab6597e12e4e32a50d16c886f041fc6e1f455f202dd7b81aa1c0",
  ])

  let decoder = av1_msac_new(stream, true)
  let state = av1_palette_state(8, 8)
  let cdfs = state.uv_index[1]

  assert_eq(cdfs[0], [25257, 29145, 32768, 0])

  assert_eq(cdfs[1], [12287, 27293, 32768, 0])

  assert_eq(cdfs[2], [7033, 27960, 32768, 0])

  assert_eq(cdfs[3], [20145, 25405, 32768, 0])

  assert_eq(cdfs[4], [30608, 31639, 32768, 0])

  let actual_0 = av1_palette_decode_index_map(decoder, 3, 4, 4, 4, 4, cdfs).unwrap()

  let expected_0 = av1_palette_index_reference_bytes([
    "00000101000100020002000102010201",
  ])

  assert_eq(actual_0.length(), expected_0.length())
  for i in 0..<actual_0.length() {
    assert_eq((i, actual_0[i]), (i, expected_0[i].to_int()))
  }

  assert_eq(av1_palette_literal(decoder, 16), 42451)

  assert_eq(cdfs[0], [23932, 28260, 32768, 6])

  assert_eq(cdfs[1], [13973, 26336, 32768, 3])

  assert_eq(cdfs[2], [5796, 23040, 32768, 3])

  assert_eq(cdfs[3], [17706, 24249, 32768, 2])

  assert_eq(cdfs[4], [28695, 31709, 32768, 1])

  let actual_1 = av1_palette_decode_index_map(decoder, 3, 16, 8, 8, 12, cdfs).unwrap()

  let expected_1 = av1_palette_index_reference_bytes([
    "020001010200020001020001010101010001000202010200020102020202020200020001000201010200000101010101",
    "020102020002000000000002020202020102010201020101000001010101010102000001000202010101000000000000",
    "0002010000010000010201010101010100020100020001010100000000000000",
  ])

  assert_eq(actual_1.length(), expected_1.length())
  for i in 0..<actual_1.length() {
    assert_eq((i, actual_1[i]), (i, expected_1[i].to_int()))
  }

  assert_eq(av1_palette_literal(decoder, 16), 42451)

  assert_eq(cdfs[0], [12870, 23631, 32768, 24])

  assert_eq(cdfs[1], [12116, 24246, 32768, 24])

  assert_eq(cdfs[2], [6183, 18349, 32768, 32])

  assert_eq(cdfs[3], [12133, 25283, 32768, 19])

  assert_eq(cdfs[4], [24269, 28372, 32768, 6])

  let actual_2 = av1_palette_decode_index_map(decoder, 3, 8, 16, 12, 8, cdfs).unwrap()

  let expected_2 = av1_palette_index_reference_bytes([
    "010001010202000200010002020002010002000100010001010102020102010102010200010202020201010200020200",
    "010101020202000102020001020201020001000100010000000101020000010101000002020000000000000000010102",
    "0000000000010102000000000001010200000000000101020000000000010102",
  ])

  assert_eq(actual_2.length(), expected_2.length())
  for i in 0..<actual_2.length() {
    assert_eq((i, actual_2[i]), (i, expected_2[i].to_int()))
  }

  assert_eq(av1_palette_literal(decoder, 16), 42451)

  assert_eq(cdfs[0], [11490, 23569, 32768, 32])

  assert_eq(cdfs[1], [11103, 22336, 32768, 32])

  assert_eq(cdfs[2], [8152, 20541, 32768, 32])

  assert_eq(cdfs[3], [11515, 22970, 32768, 32])

  assert_eq(cdfs[4], [21515, 30142, 32768, 14])

  let actual_3 = av1_palette_decode_index_map(decoder, 3, 16, 16, 12, 12, cdfs).unwrap()

  let expected_3 = av1_palette_index_reference_bytes([
    "010001010201020200010001010101010001000000010201020000000000000000020000010202000100010202020202",
    "000202020102020102000202020202020002000101000200020202000000000001000200010102010101000000000000",
    "010101020001010102010000000000000202020202010002000201010101010102010000010202020001000000000000",
    "020001010200010002020201010101010202020100020202000100010101010101010101020201010200000101010101",
    "010101010202010102000001010101010101010102020101020000010101010101010101020201010200000101010101",
    "01010101020201010200000101010101",
  ])

  assert_eq(actual_3.length(), expected_3.length())
  for i in 0..<actual_3.length() {
    assert_eq((i, actual_3[i]), (i, expected_3[i].to_int()))
  }

  assert_eq(av1_palette_literal(decoder, 16), 42451)

  assert_eq(cdfs[0], [12038, 24041, 32768, 32])

  assert_eq(cdfs[1], [10084, 21641, 32768, 32])

  assert_eq(cdfs[2], [7616, 19483, 32768, 32])

  assert_eq(cdfs[3], [12781, 23707, 32768, 32])

  assert_eq(cdfs[4], [16979, 27490, 32768, 26])

  assert_eq(decoder.allow_update, true)
  assert_true(decoder.symbol_max_bits >= -14)
}

///|
test "original AOM palette index N4 Y frozen four maps" {
  let stream = av1_palette_index_reference_bytes([
    "2190d02aaf21b7a4aab639700fef6289ab311bdccbe139a99ec9f69aec70de4e37f2dae2ff8a7d0ee457a50a80892b1e",
    "fca13f6e2f1eebb38b508f4d42f66f3c130b4bce316d069427dc34fa8287f14bcfc4d69fde66753e251b7a0a6447b3e3",
    "ea9d104af1d3087ca8d5b512a10f4a67dcabadf0f2719f0aaa20aabe24479404e13fbfbd6e8b1bd8af1ace48aea33758",
    "7352480fd7ce38bb8abe56e46fb57fdb6fa02131950d1b1243b13226bbd3f7fcf0c4f999db25d4b3953651e1b9f739e4",
    "f108af048750d7e0eec902d9b28dc2659bbe78b3ba68ce66970977d504a024f42925a7199e416cd3ee9ae72efe97a839",
    "66b5947ea1252d5c617564a592c859d72f1df5b7116f1a4bee48c041a29217e77424c9777605f3b0db99f8eb5ed92c7e",
    "227eb36b411837949b95da2b5c6c3f5a7b3fe09565f9e43ddb2c3273faff6df5b5fb8d6584bc49f21b1b0ae4908fa397",
    "36fba912e2dacb57c7900f8b91ed3981babc0247505ec3592ca82110982d04486923cf3e3b7db8f9a8a41fffb1b011a9",
    "636d913164007c865c9622ebc1d8bb149dc176c45e51a2f856f80dd9bf8106d5d3b1ef8fe1cf3c9fb4fa93cc1e0509d5",
    "76b85a948efa493080",
  ])

  let decoder = av1_msac_new(stream, false)
  let state = av1_palette_state(8, 8)
  let cdfs = state.y_index[2]

  assert_eq(cdfs[0], [25572, 28046, 30045, 32768, 0])

  assert_eq(cdfs[1], [9478, 21590, 27256, 32768, 0])

  assert_eq(cdfs[2], [7248, 26837, 29824, 32768, 0])

  assert_eq(cdfs[3], [19167, 24486, 28349, 32768, 0])

  assert_eq(cdfs[4], [31400, 31825, 32250, 32768, 0])

  let actual_0 = av1_palette_decode_index_map(decoder, 4, 8, 8, 8, 8, cdfs).unwrap()

  let expected_0 = av1_palette_index_reference_bytes([
    "000001010203010000010001000302010002000202030202010100000202010202010301030201000200000201010003",
    "00010202000100010300020202000102",
  ])

  assert_eq(actual_0.length(), expected_0.length())
  for i in 0..<actual_0.length() {
    assert_eq((i, actual_0[i]), (i, expected_0[i].to_int()))
  }

  assert_eq(av1_palette_literal(decoder, 16), 42451)

  assert_eq(cdfs[0], [25572, 28046, 30045, 32768, 0])

  assert_eq(cdfs[1], [9478, 21590, 27256, 32768, 0])

  assert_eq(cdfs[2], [7248, 26837, 29824, 32768, 0])

  assert_eq(cdfs[3], [19167, 24486, 28349, 32768, 0])

  assert_eq(cdfs[4], [31400, 31825, 32250, 32768, 0])

  let actual_1 = av1_palette_decode_index_map(decoder, 4, 32, 16, 16, 24, cdfs).unwrap()

  let expected_1 = av1_palette_index_reference_bytes([
    "030001010203030103030201020201010103000203000302020202020202020200010000010102010001010003020300",
    "010303000302020303030303030303030002000202020003010201000301010102010000010200000000000000000000",
