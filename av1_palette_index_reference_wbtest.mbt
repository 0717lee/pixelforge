///|
test "original AOM palette index N8 UV frozen four maps" {
  let stream = av1_palette_index_reference_bytes([
    "09d93f71a94ff34398466b4b412ecf063734c5bb9445b2c1476c5b28afa764cb3dcd0db978ecfcbdb2b5ef68e146f6d6",
    "1d4d57d061ba6d3fa6e5854cd25d5fe879cd0f62670c16289b81c0906eff539095a5e45c09c218656ed0f495121fe75e",
    "d6a5ef25eb98d2d0902820176469addc8ac18d06e93994bfa50b5d314b4c6341f7b882becea0d1eba82a5d5a9e9841a0",
    "cfaa5c3e4d1308375e7574a0b5edb33fac68d330",
  ])

  let decoder = av1_msac_new(stream, false)
  let state = av1_palette_state(8, 8)
  let cdfs = state.uv_index[6]

  assert_eq(cdfs[0], [21442, 23288, 24758, 26246, 27649, 28980, 30563, 32768, 0])

  assert_eq(cdfs[1], [5863, 14933, 17552, 20668, 23683, 26411, 29273, 32768, 0])

  assert_eq(cdfs[2], [3415, 25810, 26877, 27990, 29223, 30394, 31618, 32768, 0])

  assert_eq(cdfs[3], [17965, 20084, 22232, 23974, 26274, 28402, 30390, 32768, 0])

  assert_eq(cdfs[4], [31190, 31329, 31516, 31679, 31825, 32026, 32322, 32768, 0])

  let actual_0 = av1_palette_decode_index_map(decoder, 8, 4, 4, 4, 4, cdfs).unwrap()

  let expected_0 = av1_palette_index_reference_bytes([
    "00000101000100020002000304050607",
  ])

  assert_eq(actual_0.length(), expected_0.length())
  for i in 0..<actual_0.length() {
    assert_eq((i, actual_0[i]), (i, expected_0[i].to_int()))
  }

  assert_eq(av1_palette_literal(decoder, 16), 42451)

  assert_eq(cdfs[0], [21442, 23288, 24758, 26246, 27649, 28980, 30563, 32768, 0])

  assert_eq(cdfs[1], [5863, 14933, 17552, 20668, 23683, 26411, 29273, 32768, 0])

  assert_eq(cdfs[2], [3415, 25810, 26877, 27990, 29223, 30394, 31618, 32768, 0])

  assert_eq(cdfs[3], [17965, 20084, 22232, 23974, 26274, 28402, 30390, 32768, 0])

  assert_eq(cdfs[4], [31190, 31329, 31516, 31679, 31825, 32026, 32322, 32768, 0])

  let actual_1 = av1_palette_decode_index_map(decoder, 8, 16, 8, 8, 12, cdfs).unwrap()

  let expected_1 = av1_palette_index_reference_bytes([
    "070001010203040506070105050505050001000407060500060502040404040400020001000405010405040000000000",
    "050003040402010704030401010101010304000701010001060000060606060606000204070005070605010000000000",
    "0700000405000203040602060606060606040707010506040500050000000000",
  ])

  assert_eq(actual_1.length(), expected_1.length())
  for i in 0..<actual_1.length() {
    assert_eq((i, actual_1[i]), (i, expected_1[i].to_int()))
  }

  assert_eq(av1_palette_literal(decoder, 16), 42451)

  assert_eq(cdfs[0], [21442, 23288, 24758, 26246, 27649, 28980, 30563, 32768, 0])

  assert_eq(cdfs[1], [5863, 14933, 17552, 20668, 23683, 26411, 29273, 32768, 0])

  assert_eq(cdfs[2], [3415, 25810, 26877, 27990, 29223, 30394, 31618, 32768, 0])

  assert_eq(cdfs[3], [17965, 20084, 22232, 23974, 26274, 28402, 30390, 32768, 0])

  assert_eq(cdfs[4], [31190, 31329, 31516, 31679, 31825, 32026, 32322, 32768, 0])

  let actual_2 = av1_palette_decode_index_map(decoder, 8, 8, 16, 12, 8, cdfs).unwrap()

  let expected_2 = av1_palette_index_reference_bytes([
    "040001010203040500010006070205030002000107060205030402070502050107030206010001000403020700020402",
    "070103000404060506030104020602040701030205050107000200000603040004030203050603000507040303070306",
    "0507040303070306050704030307030605070403030703060507040303070306",
  ])

  assert_eq(actual_2.length(), expected_2.length())
  for i in 0..<actual_2.length() {
    assert_eq((i, actual_2[i]), (i, expected_2[i].to_int()))
  }

  assert_eq(av1_palette_literal(decoder, 16), 42451)

  assert_eq(cdfs[0], [21442, 23288, 24758, 26246, 27649, 28980, 30563, 32768, 0])

  assert_eq(cdfs[1], [5863, 14933, 17552, 20668, 23683, 26411, 29273, 32768, 0])

  assert_eq(cdfs[2], [3415, 25810, 26877, 27990, 29223, 30394, 31618, 32768, 0])

  assert_eq(cdfs[3], [17965, 20084, 22232, 23974, 26274, 28402, 30390, 32768, 0])

  assert_eq(cdfs[4], [31190, 31329, 31516, 31679, 31825, 32026, 32322, 32768, 0])

  let actual_3 = av1_palette_decode_index_map(decoder, 8, 16, 16, 12, 12, cdfs).unwrap()

  let expected_3 = av1_palette_index_reference_bytes([
    "060001010203040506070607070707070001000102000407070503000000000000020004040107030204030000000000",
    "060205020105070300010007070707070001060604070005000101000000000002070100010007070503040505050505",
    "030201070100070307070205050505050106010201000302000301040404040400040302040207070600060000000000",
    "000307040600010000040604040404040700060304020301020007060606060602070205000203040501000000000000",
    "020702050002030405010000000000000207020500020304050100000000000002070205000203040501000000000000",
    "02070205000203040501000000000000",
  ])

  assert_eq(actual_3.length(), expected_3.length())
  for i in 0..<actual_3.length() {
    assert_eq((i, actual_3[i]), (i, expected_3[i].to_int()))
  }

  assert_eq(av1_palette_literal(decoder, 16), 42451)

  assert_eq(cdfs[0], [21442, 23288, 24758, 26246, 27649, 28980, 30563, 32768, 0])

  assert_eq(cdfs[1], [5863, 14933, 17552, 20668, 23683, 26411, 29273, 32768, 0])

  assert_eq(cdfs[2], [3415, 25810, 26877, 27990, 29223, 30394, 31618, 32768, 0])

  assert_eq(cdfs[3], [17965, 20084, 22232, 23974, 26274, 28402, 30390, 32768, 0])

  assert_eq(cdfs[4], [31190, 31329, 31516, 31679, 31825, 32026, 32322, 32768, 0])

  assert_eq(decoder.allow_update, false)
  assert_true(decoder.symbol_max_bits >= -14)
}

///|
test "original AOM palette index N8 UV adaptive four maps" {
  let stream = av1_palette_index_reference_bytes([
    "0a3fbf011cb7203cb1c077ffebcadd406926603e64fa907374d98efdbf45f555ea725f92ae8eaaabffd0242d740120aa",
    "53c13bad6a53d81fcf6bf699f8fcd37650c302612b325d1cb8d3bb882921df28e21149685359c15195db560ece9bb1a9",
    "7f6715a7333fea447b84008375b6c13f2c61daa4d990c2e97a32457d6315f30eed810ac8663df16107203f5c01d7df6b",
    "16869dcaaceda8",
  ])

  let decoder = av1_msac_new(stream, true)
  let state = av1_palette_state(8, 8)
  let cdfs = state.uv_index[6]

  assert_eq(cdfs[0], [21442, 23288, 24758, 26246, 27649, 28980, 30563, 32768, 0])

  assert_eq(cdfs[1], [5863, 14933, 17552, 20668, 23683, 26411, 29273, 32768, 0])

  assert_eq(cdfs[2], [3415, 25810, 26877, 27990, 29223, 30394, 31618, 32768, 0])

  assert_eq(cdfs[3], [17965, 20084, 22232, 23974, 26274, 28402, 30390, 32768, 0])

  assert_eq(cdfs[4], [31190, 31329, 31516, 31679, 31825, 32026, 32322, 32768, 0])

  let actual_0 = av1_palette_decode_index_map(decoder, 8, 4, 4, 4, 4, cdfs).unwrap()

  let expected_0 = av1_palette_index_reference_bytes([
    "00000101000100020002000304050607",
  ])

  assert_eq(actual_0.length(), expected_0.length())
  for i in 0..<actual_0.length() {
    assert_eq((i, actual_0[i]), (i, expected_0[i].to_int()))
  }

  assert_eq(av1_palette_literal(decoder, 16), 42451)

  assert_eq(cdfs[0], [21450, 23907, 25121, 26351, 28534, 29635, 30941, 32768, 6])

  assert_eq(cdfs[1], [6096, 14084, 16391, 19135, 21791, 25153, 28665, 32768, 4])

  assert_eq(cdfs[2], [3106, 23467, 26388, 28423, 29544, 30608, 31720, 32768, 3])

  assert_eq(cdfs[3], [17404, 20480, 22561, 24248, 26476, 28538, 30464, 32768, 1])

  assert_eq(cdfs[4], [30216, 31373, 31555, 31713, 31854, 32049, 32335, 32768, 1])

  let actual_1 = av1_palette_decode_index_map(decoder, 8, 16, 8, 8, 12, cdfs).unwrap()

  let expected_1 = av1_palette_index_reference_bytes([
    "070001010203040506070105050505050001000407060500060502040404040400020001000405010405040000000000",
    "050003040402010704030401010101010304000701010001060000060606060606000204070005070605010000000000",
    "0700000405000203040602060606060606040707010506040500050000000000",
  ])

  assert_eq(actual_1.length(), expected_1.length())
  for i in 0..<actual_1.length() {
    assert_eq((i, actual_1[i]), (i, expected_1[i].to_int()))
  }

  assert_eq(av1_palette_literal(decoder, 16), 42451)

  assert_eq(cdfs[0], [
    15289, 18964, 21067, 22732, 25437, 27921, 30148, 32768, 24,
  ])

  assert_eq(cdfs[1], [5045, 11439, 15075, 18198, 21204, 24671, 29091, 32768, 32])

  assert_eq(cdfs[2], [2723, 15577, 21447, 24441, 25836, 28367, 30460, 32768, 19])

  assert_eq(cdfs[3], [
    12278, 15217, 20194, 23871, 25441, 28880, 30237, 32768, 12,
  ])

  assert_eq(cdfs[4], [30216, 31373, 31555, 31713, 31854, 32049, 32335, 32768, 1])

  let actual_2 = av1_palette_decode_index_map(decoder, 8, 8, 16, 12, 8, cdfs).unwrap()

  let expected_2 = av1_palette_index_reference_bytes([
    "040001010203040500010006070205030002000107060205030402070502050107030206010001000403020700020402",
    "070103000404060506030104020602040701030205050107000200000603040004030203050603000507040303070306",
    "0507040303070306050704030307030605070403030703060507040303070306",
  ])

  assert_eq(actual_2.length(), expected_2.length())
  for i in 0..<actual_2.length() {
    assert_eq((i, actual_2[i]), (i, expected_2[i].to_int()))
  }

  assert_eq(av1_palette_literal(decoder, 16), 42451)

  assert_eq(cdfs[0], [
    13364, 17902, 20080, 22132, 24832, 27597, 29412, 32768, 32,
  ])

  assert_eq(cdfs[1], [5172, 9886, 14181, 17996, 21876, 25271, 29186, 32768, 32])

  assert_eq(cdfs[2], [2763, 13869, 19602, 22566, 23720, 26311, 29471, 32768, 31])

  assert_eq(cdfs[3], [9100, 13001, 18406, 22067, 23740, 28117, 30886, 32768, 27])

  assert_eq(cdfs[4], [30216, 31373, 31555, 31713, 31854, 32049, 32335, 32768, 1])

  let actual_3 = av1_palette_decode_index_map(decoder, 8, 16, 16, 12, 12, cdfs).unwrap()

  let expected_3 = av1_palette_index_reference_bytes([
    "060001010203040506070607070707070001000102000407070503000000000000020004040107030204030000000000",
    "060205020105070300010007070707070001060604070005000101000000000002070100010007070503040505050505",
    "030201070100070307070205050505050106010201000302000301040404040400040302040207070600060000000000",
    "000307040600010000040604040404040700060304020301020007060606060602070205000203040501000000000000",
    "020702050002030405010000000000000207020500020304050100000000000002070205000203040501000000000000",
    "02070205000203040501000000000000",
  ])

  assert_eq(actual_3.length(), expected_3.length())
  for i in 0..<actual_3.length() {
    assert_eq((i, actual_3[i]), (i, expected_3[i].to_int()))
  }

  assert_eq(av1_palette_literal(decoder, 16), 42451)

  assert_eq(cdfs[0], [
    11948, 16891, 19424, 21872, 24379, 26942, 28936, 32768, 32,
  ])

  assert_eq(cdfs[1], [4796, 9405, 14413, 19391, 22477, 25906, 29481, 32768, 32])

  assert_eq(cdfs[2], [2626, 13176, 19230, 21991, 24761, 27259, 29736, 32768, 32])

  assert_eq(cdfs[3], [7968, 12088, 17513, 20717, 22433, 27463, 30134, 32768, 32])

  assert_eq(cdfs[4], [29272, 30393, 30569, 30722, 31882, 32071, 32348, 32768, 2])

  assert_eq(decoder.allow_update, true)
  assert_true(decoder.symbol_max_bits >= -14)
}
