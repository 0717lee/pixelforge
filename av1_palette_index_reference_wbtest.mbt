///|
test "original AOM palette index N6 UV adaptive four maps" {
  let stream = av1_palette_index_reference_bytes([
    "16f41705f31c3cee8e99042b052a427bb1da58ce1f6978284ad059323fcf142a5e9913935c2418264b1ebf775efe64be",
