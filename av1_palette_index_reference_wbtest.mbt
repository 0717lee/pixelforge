///|
test "original AOM palette index N2 Y frozen four maps" {
  let stream = av1_palette_index_reference_bytes([
    "625784d26f600dca1b539c9c888a9df08e14335ee03f82a4f2a857c2fe93ae31d606e4776a48f187ebdc75b3739dbb0a",
    "9e1f2ccd6a109ac8d9fb2cb7813bfa29a407412f7a39d8032735e3d16602b9a925e80cbc6026602e6f4c975fb29ca27c",
    "b22a8be6a7b0e9930c20cc589db3b5a8f6a31e72f4ccedc58dfe9d50211156ecf2e3fe29a27331c74ac8abab63ad7f2d",
    "5bfcece577e9124ef1a251ecb677217c861f093eaa9e9ad518cff79626a18845b0cc1f90b11f2fc6feca1d74fdd507ec",
    "2176b67cd771e7e4908034ab9b644d67cf2a60f380bc0beb2dc1d5a11f1b45e477e5516a385c6055b2c460c8e83ce999",
    "aa71aefcc4cd74a0a5654331c7f56fe7f8b128ec62b9d7a619223a22d03c0d94a76f0f235b0b66816891beb1c122",
  ])

  let decoder = av1_msac_new(stream, false)
  let state = av1_palette_state(8, 8)
  let cdfs = state.y_index[0]

  assert_eq(cdfs[0], [28710, 32768, 0])

  assert_eq(cdfs[1], [16384, 32768, 0])

  assert_eq(cdfs[2], [10553, 32768, 0])

  assert_eq(cdfs[3], [27036, 32768, 0])

  assert_eq(cdfs[4], [31603, 32768, 0])

  let actual_0 = av1_palette_decode_index_map(decoder, 2, 8, 8, 8, 8, cdfs).unwrap()

  let expected_0 = av1_palette_index_reference_bytes([
    "000001010100010000010000010100000000000001010000000000000000000101010001010101010101010000010001",
    "01000000000101000000010100000100",
  ])

  assert_eq(actual_0.length(), expected_0.length())
  for i in 0..<actual_0.length() {
    assert_eq((i, actual_0[i]), (i, expected_0[i].to_int()))
  }

  assert_eq(av1_palette_literal(decoder, 16), 42451)

  assert_eq(cdfs[0], [28710, 32768, 0])

  assert_eq(cdfs[1], [16384, 32768, 0])

  assert_eq(cdfs[2], [10553, 32768, 0])

  assert_eq(cdfs[3], [27036, 32768, 0])

  assert_eq(cdfs[4], [31603, 32768, 0])

  let actual_1 = av1_palette_decode_index_map(decoder, 2, 32, 16, 16, 24, cdfs).unwrap()

  let expected_1 = av1_palette_index_reference_bytes([
    "010001010101010101000000010000010101010001010100000000000000000000010000000001000101010101000101",
    "000100000000010101010101010101010000000101000101000001010101000101000000000001000000000000000000",
    "010000010001000000010101000101010101000001000100000000000000000001000000010000010001000000000000",
    "010100010100010101010101010101010000000100010100000001000001000001000100000101000000000000000000",
    "010000010100000100010001000100010000000000000101010101010101010100010000000100000101000000000101",
    "010000000100010101010101010101010100010001010001000001010101000100010100000101000000000000000000",
    "000101000001010000000001000101000101000001000001010101010101010100000000000101010000000001000100",
    "010100000100010000000000000000000100000100000101000100010101010100010000000000000000000000000000",
    "000101000001010001010100000000010000000101000000000000000000000000000000010101000101010001000001",
    "010000000101000101010101010101010000010101000001000100010000000000000001010000000000000000000000",
    "0101000101010000010101010100000000000100000100010101010101010101",
  ])

  assert_eq(actual_1.length(), expected_1.length())
  for i in 0..<actual_1.length() {
    assert_eq((i, actual_1[i]), (i, expected_1[i].to_int()))
  }

  assert_eq(av1_palette_literal(decoder, 16), 42451)

  assert_eq(cdfs[0], [28710, 32768, 0])

  assert_eq(cdfs[1], [16384, 32768, 0])

  assert_eq(cdfs[2], [10553, 32768, 0])

  assert_eq(cdfs[3], [27036, 32768, 0])

  assert_eq(cdfs[4], [31603, 32768, 0])

  let actual_2 = av1_palette_decode_index_map(decoder, 2, 16, 32, 24, 16, cdfs).unwrap()

  let expected_2 = av1_palette_index_reference_bytes([
    "010001010001000001010000000000000001000101000001000101000101000100000000000001010101000101000001",
    "010000000000000000000001000101000000010000010001000101000100000101000000010000000101000101000101",
    "010100010000000101010101010100010001010001000101000001000100000001010101010100000100000101010100",
    "010001010100010001000001000100000001010000010001010001010100010101010001010100000000010000010001",
    "010101010000000101010100000000010000000001010000010001000100010001000001010101000101000101010001",
    "010101010000010100000000000101000000010101010101010000000000000001000100010000000100000100000000",
    "010100000100000101000000000101000001010001010000000000000100000100000100000000010101000000000100",
    "010000000001010101000000010100000001000101000000010100010001000101000001010001000000000000000100",
    "010000010100010000000000000001000100000101000100000000000000010001000001010001000000000000000100",
    "010000010100010000000000000001000100000101000100000000000000010001000001010001000000000000000100",
    "0100000101000100000000000000010001000001010001000000000000000100",
  ])

  assert_eq(actual_2.length(), expected_2.length())
  for i in 0..<actual_2.length() {
    assert_eq((i, actual_2[i]), (i, expected_2[i].to_int()))
  }

  assert_eq(av1_palette_literal(decoder, 16), 42451)

  assert_eq(cdfs[0], [28710, 32768, 0])

  assert_eq(cdfs[1], [16384, 32768, 0])

  assert_eq(cdfs[2], [10553, 32768, 0])

  assert_eq(cdfs[3], [27036, 32768, 0])

  assert_eq(cdfs[4], [31603, 32768, 0])

  let actual_3 = av1_palette_decode_index_map(decoder, 2, 32, 32, 24, 24, cdfs).unwrap()

  let expected_3 = av1_palette_index_reference_bytes([
    "000001010000000101000001010000000001000101010000000000000000000000010001010001000100010100000001",
    "010100000000010101010101010101010000000001000001000100000100010001000100000000010101010101010101",
    "010101000000000000000000000101010100010000010001010101010101010101000101000001010001010101000001",
    "000000000001000000000000000000000100000100010100000101010000000000000001010000010101010101010101",
    "010101000101000000010001010001010101000001010101010101010101010100010100000101000101000101000000",
    "000101000101010101010101010101010101010100010000010101000000010101000001010101000000000000000000",
    "000100010101010100010000010100000000000100000001010101010101010100000101000100010101000100010001",
    "010001010100010000000000000000000100010000000101000000010001010100010000010100000000000000000000",
    "010001000101010000010000010101010001010101010000000000000000000001000101000001010001010001000101",
    "010001010000010101010101010101010101000101000100000000010100000000000100010000000000000000000000",
    "000001000100010000000000000001000001010000000101010101010101010100010001000100010001010000000000",
    "000101010000000101010101010101010101010100000100010100010000010001010101000100010101010101010101",
    "010000010001010000000001010101000101000100000001010101010101010100010000000001010001000000000000",
    "000100000000000000000000000000000100010001000100000100000000000000010101010101010101010101010101",
    "010100010000010101010000010101010100000001000100000000000000000000010101010101010100010101010100",
    "000101000100010000000000000000000000010000000100010001000000010001000001000000010101010101010101",
    "000001000000010001000100000001000100000100000001010101010101010100000100000001000100010000000100",
    "010000010000000101010101010101010000010000000100010001000000010001000001000000010101010101010101",
    "000001000000010001000100000001000100000100000001010101010101010100000100000001000100010000000100",
    "010000010000000101010101010101010000010000000100010001000000010001000001000000010101010101010101",
    "000001000000010001000100000001000100000100000001010101010101010100000100000001000100010000000100",
    "01000001000000010101010101010101",
  ])

  assert_eq(actual_3.length(), expected_3.length())
  for i in 0..<actual_3.length() {
    assert_eq((i, actual_3[i]), (i, expected_3[i].to_int()))
  }

  assert_eq(av1_palette_literal(decoder, 16), 42451)

  assert_eq(cdfs[0], [28710, 32768, 0])

  assert_eq(cdfs[1], [16384, 32768, 0])

  assert_eq(cdfs[2], [10553, 32768, 0])

  assert_eq(cdfs[3], [27036, 32768, 0])

  assert_eq(cdfs[4], [31603, 32768, 0])

  assert_eq(decoder.allow_update, false)
  assert_true(decoder.symbol_max_bits >= -14)
}

///|
test "original AOM palette index N2 Y adaptive four maps" {
  let stream = av1_palette_index_reference_bytes([
    "63368112055416fd2f3738dc57c5c2046944e3c1e515052a0dad7fe8b1062eba754418d11bfe6924dcb9696751aed9e0",
    "4f306a3a2bb9c89b0021625cfb5da87c9de29a6b299241fa9385d7a8f918b19cd47e4b4f4878da9f9c7ca0e2c7450e31",
    "f05660412b7fe3a705e8dedf047c9f74e9c9dbde558a48a631586b4e84e862fab9488cd6d573cc2bf92b0194e17319b8",
    "e7ca7e2da765e30755e46fc54bcfa883449f3623668966960987692d5a0438ce15f91f05351f7230943cab",
  ])

  let decoder = av1_msac_new(stream, true)
  let state = av1_palette_state(8, 8)
  let cdfs = state.y_index[0]

  assert_eq(cdfs[0], [28710, 32768, 0])

  assert_eq(cdfs[1], [16384, 32768, 0])

  assert_eq(cdfs[2], [10553, 32768, 0])

  assert_eq(cdfs[3], [27036, 32768, 0])

  assert_eq(cdfs[4], [31603, 32768, 0])

  let actual_0 = av1_palette_decode_index_map(decoder, 2, 8, 8, 8, 8, cdfs).unwrap()

  let expected_0 = av1_palette_index_reference_bytes([
    "000001010100010000010000010100000000000001010000000000000000000101010001010101010101010000010001",
    "01000000000101000000010100000100",
  ])

  assert_eq(actual_0.length(), expected_0.length())
  for i in 0..<actual_0.length() {
    assert_eq((i, actual_0[i]), (i, expected_0[i].to_int()))
  }

  assert_eq(av1_palette_literal(decoder, 16), 42451)

  assert_eq(cdfs[0], [21588, 32768, 14])

  assert_eq(cdfs[1], [16384, 32768, 0])

  assert_eq(cdfs[2], [13042, 32768, 25])

  assert_eq(cdfs[3], [23780, 32768, 10])

  assert_eq(cdfs[4], [23001, 32768, 14])

  let actual_1 = av1_palette_decode_index_map(decoder, 2, 32, 16, 16, 24, cdfs).unwrap()

  let expected_1 = av1_palette_index_reference_bytes([
    "010001010101010101000000010000010101010001010100000000000000000000010000000001000101010101000101",
    "000100000000010101010101010101010000000101000101000001010101000101000000000001000000000000000000",
    "010000010001000000010101000101010101000001000100000000000000000001000000010000010001000000000000",
    "010100010100010101010101010101010000000100010100000001000001000001000100000101000000000000000000",
    "010000010100000100010001000100010000000000000101010101010101010100010000000100000101000000000101",
    "010000000100010101010101010101010100010001010001000001010101000100010100000101000000000000000000",
    "000101000001010000000001000101000101000001000001010101010101010100000000000101010000000001000100",
    "010100000100010000000000000000000100000100000101000100010101010100010000000000000000000000000000",
    "000101000001010001010100000000010000000101000000000000000000000000000000010101000101010001000001",
    "010000000101000101010101010101010000010101000001000100010000000000000001010000000000000000000000",
    "0101000101010000010101010100000000000100000100010101010101010101",
  ])

  assert_eq(actual_1.length(), expected_1.length())
