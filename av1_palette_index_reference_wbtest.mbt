///|
test "original AOM palette full color order N2 exhaustive" {
  let data = av1_palette_index_reference_contexts()
  for offset = 0; offset < data.length(); offset = offset + 14 {
    if data[offset].to_int() != 2 {
      continue
    }
    let kind = data[offset + 1].to_int()
    let row = if kind == 0 { 0 } else { 1 }
    let col = if kind == 1 { 0 } else { 1 }
    let indices : Array[Int] = Array::make(9, -777)
    if col > 0 {
      indices[row * 3 + col - 1] = data[offset + 2].to_int()
    }
    if row > 0 && col > 0 {
      indices[(row - 1) * 3 + col - 1] = data[offset + 3].to_int()
    }
    if row > 0 {
      indices[(row - 1) * 3 + col] = data[offset + 4].to_int()
    }
    let (context, order) = av1_palette_index_context(indices, 3, row, col, 2).unwrap()
    assert_eq((offset, context), (offset, data[offset + 5].to_int()))
    assert_eq(order.length(), 8)
    for i in 0..<8 {
      assert_eq(
        (offset, i, order[i]),
        (offset, i, data[offset + 6 + i].to_int()),
      )
    }
  }
}

