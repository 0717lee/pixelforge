    "2992379bfbc941eb472b3a73eae48a2c4d5bd3f7e6487413a46cd0713ce4d9c08f0f7f1de0",
  ])

  let decoder = av1_msac_new(stream, true)
  let state = av1_palette_state(8, 8)
  let cdfs = state.uv_index[4]

  assert_eq(cdfs[0], [22217, 24567, 26637, 28683, 30548, 32768, 0])

