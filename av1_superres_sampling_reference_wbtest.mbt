  let frame = av1_decode_frame_planes(data).unwrap()
  assert_eq(
    (frame.width, frame.height, frame.sub_x, frame.sub_y),
    (96, 64, 0, 0),
  )
  let mut offset = 0
  for plane in 0..<3 {
    let actual = av1_frame_crop(frame, plane)
    for i in 0..<actual.length() {
      assert_eq((plane, i, actual[i]), (plane, i, expected[offset + i]))
    }
    offset = offset + actual.length()
  }
  assert_eq(offset, expected.length())
}
