///|
test "external libaom multi-tile tiles2x2_8bit_q10" {
  let stream : Array[Byte] = [
    b'\x12', b'\x00', b'\x0A', b'\x06', b'\x18', b'\x19', b'\xBF', b'\xFF', b'\x00',
    b'\x02', b'\x32', b'\x1C', b'\x1C', b'\x0A', b'\x00', b'\x00', b'\x01', b'\x00',
    b'\x00', b'\x04', b'\x00', b'\xEB', b'\xC8', b'\xE2', b'\x40', b'\x03', b'\x00',
    b'\xEB', b'\xCC', b'\x9F', b'\x03', b'\x00', b'\xE2', b'\x3A', b'\x4B', b'\x00',
    b'\xE2', b'\x36', b'\xB7', b'\x40',
  ]
  let actual = av1_decode(stream).unwrap()
  let expected = av1_multitile_reference_expected(128, 128, 8, [
    (64, 128, 128),
    (96, 128, 128),
    (160, 128, 128),
    (192, 128, 128),
  ])
  assert_eq((actual.width, actual.height), (128, 128))
  for y in 0..<128 {
    for x in 0..<128 {
      assert_eq(actual.get_pixel(x, y), expected.get_pixel(x, y))
    }
  }
}

