///|
fn avif_grid_frame_pair_descriptor(
  first_size : Int,
  second_size : Int,
) -> AvifGridDescriptor {
  {
    item_id: 1,
    rows: 1,
    columns: 2,
    output_width: 128,
    output_height: 64,
    tiles: [
      {
        item_id: 2,
        extents: [{ offset: 0, length: first_size, construction_method: 0, }],
      },
      {
        item_id: 3,
        extents: [
          { offset: first_size, length: second_size, construction_method: 0, },
        ],
      },
    ],
  }
}

