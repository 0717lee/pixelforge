test "inter_diffwtd_64x64: the difference-weighted blend reconstructs the inter frame" {
  let map = av1_frame_map()
  let whole = inter_diffwtd_64x64_obu
  let key_unit = av1_inter_slice_bytes(whole, 0, 84)
  let inter_unit = av1_inter_slice_bytes(whole, 84, whole.length())
  let sequence = match av1_sequence_info(key_unit) {
    Some(value) => value
    None => fail("inter_diffwtd_64x64: no sequence header")
  }
  if av1_decode_frame_planes(key_unit, map~) is None {
    fail("inter_diffwtd_64x64: key frame decode rejected")
  }
  let inter = av1_decode_frame_planes(inter_unit, map~, sequence~)
  let frame = match inter {
    Some(value) => value
    None => fail("inter_diffwtd_64x64: diffwtd frame rejected")
  }
  let reference = av1_inter_expand(inter_diffwtd_64x64_frame1_reference)
  let chroma = 6144 / 6
  let luma_size = 6144 - chroma * 2
  let bad = [0, 0, 0]
  for p in 0..<3 {
    let got = av1_frame_crop(frame, p)
    let start = if p == 0 {
      0
    } else if p == 1 {
      luma_size
    } else {
      luma_size + chroma
    }
    for i in 0..<got.length() {
      if got[i] != reference[start + i] {
        bad[p] = bad[p] + 1
      }
    }
  }
  assert_eq(bad, [0, 0, 0])
}
