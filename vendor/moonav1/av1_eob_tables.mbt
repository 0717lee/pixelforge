///|
pub fn av1_coeff_eob_small_default(
  kind : Int,
  q_context : Int,
  plane : Int,
  tx_class : Int,
) -> Array[Int] {
  match kind {
    0 => defaultEobPt16Cdf[q_context][plane][tx_class].copy()
    1 => defaultEobPt32Cdf[q_context][plane][tx_class].copy()
    2 => defaultEobPt64Cdf[q_context][plane][tx_class].copy()
    3 => defaultEobPt128Cdf[q_context][plane][tx_class].copy()
    4 => defaultEobPt256Cdf[q_context][plane][tx_class].copy()
    5 => defaultEobPt512Cdf[q_context][plane].copy()
    _ => abort("invalid AV1 EOB table kind")
  }
}

///|
test "AV1 small EOB tables expose valid CDF leaves" {
  for kind in 0..<6 {
    let cdf = av1_coeff_eob_small_default(kind, 0, 0, 0)
    assert_eq(cdf[cdf.length() - 2], 32768)
  }
}
