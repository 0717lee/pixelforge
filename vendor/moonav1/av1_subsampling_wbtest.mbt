    b'\x18', b'\xB7', b'\xC4', b'\x8C', b'\x11', b'\x63', b'\x61', b'\x9A', b'\x3E',
    b'\x98', b'\x43', b'\x60', b'\xF2', b'\xF8', b'\x44', b'\x6F', b'\x22', b'\x0A',
    b'\xE3', b'\xF1', b'\xAE', b'\x9F', b'\xC0',
  ]
}

///|
/// Profile and subsampling come from the sequence header color config: profile
/// 1 is 4:4:4 with no monochrome bit, and profile 2 at eight bits is 4:2:2.
test "sequence color config distinguishes 4:4:4 and 4:2:2" {
  let seq444 = av1_sequence_info(av1_sub444_stream()).unwrap()
  assert_eq(seq444.profile, 1)
  assert_eq(seq444.monochrome, false)
  assert_eq(seq444.subsampling_x, false)
  assert_eq(seq444.subsampling_y, false)
  let seq422 = av1_sequence_info(av1_sub422_stream()).unwrap()
  assert_eq(seq422.profile, 2)
  assert_eq(seq422.monochrome, false)
  assert_eq(seq422.subsampling_x, true)
  assert_eq(seq422.subsampling_y, false)
}

///|
/// 4:4:4 planes are all 64x64 and match dav1d sample for sample.
test "4:4:4 stream matches dav1d pixel truth" {
  let frame = av1_decode_frame_planes(av1_sub444_stream()).unwrap()
  let y = av1_frame_crop(frame, 0)
  let u = av1_frame_crop(frame, 1)
  let v = av1_frame_crop(frame, 2)
  assert_eq(y.length(), 4096)
  assert_eq(u.length(), 4096)
  assert_eq(v.length(), 4096)
  assert_eq(av1_plane_digest(y), 12264532)
  assert_eq(av1_plane_digest(u), 13617159)
  assert_eq(av1_plane_digest(v), 5016429)
  assert_eq(u[0], 90)
  assert_eq(u[1], 92)
  assert_eq(u[2], 94)
  assert_eq(v[0], 140)
  assert_eq(v[64], 142)
}

///|
/// 4:2:2 keeps full vertical chroma resolution: U and V are 32x64 and match
/// dav1d, including the vertical ramp that a 4:2:0 reading would flatten.
test "4:2:2 stream matches dav1d pixel truth" {
  let frame = av1_decode_frame_planes(av1_sub422_stream()).unwrap()
  let y = av1_frame_crop(frame, 0)
  let u = av1_frame_crop(frame, 1)
  let v = av1_frame_crop(frame, 2)
  assert_eq(y.length(), 4096)
  assert_eq(u.length(), 2048)
  assert_eq(v.length(), 2048)
  assert_eq(av1_plane_digest(y), 14670826)
  assert_eq(av1_plane_digest(u), 16427600)
  assert_eq(av1_plane_digest(v), 3466790)
  assert_eq(u[0], 90)
  assert_eq(u[1], 94)
  assert_eq(u[2], 98)
  assert_eq(v[0], 140)
  assert_eq(v[32], 142)
}

///|
/// Active chroma CDEF on a 4:4:4 plane: the filter must run on full-resolution
/// chroma with the 8x8 luma-equivalent block grid. The chroma head samples
/// differ from the source ramp precisely because the filter changed them.
test "4:4:4 stream with active chroma CDEF matches dav1d pixel truth" {
  let frame = av1_decode_frame_planes(av1_sub444_cdef_stream()).unwrap()
  let y = av1_frame_crop(frame, 0)
  let u = av1_frame_crop(frame, 1)
  let v = av1_frame_crop(frame, 2)
  assert_eq(y.length(), 4096)
  assert_eq(u.length(), 4096)
  assert_eq(v.length(), 4096)
  assert_eq(av1_plane_digest(y), 5689114)
  assert_eq(av1_plane_digest(u), 8930597)
  assert_eq(av1_plane_digest(v), 7610770)
  assert_eq(u[0], 92)
  assert_eq(u[1], 93)
  assert_eq(u[2], 94)
  assert_eq(v[0], 142)
}
