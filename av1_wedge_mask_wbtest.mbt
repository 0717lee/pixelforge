test "av1_wedge_mask: every mask matches dav1d's generated table" {
  for entry in av1_wedge_mask_goldens {
    let (w, h, n, want) = entry
    let got = match av1_wedge_mask(w, h, n, 0) {
      Some(value) => value
      None => []
    }
    if got != want {
      fail("wedge mask " + w.to_string() + "x" + h.to_string() + " index " + n.to_string() + " differs")
    }
  }
  // The chroma variant halves one axis and rounds, per §7.11.3.14.
  let luma = match av1_wedge_mask(32, 32, 0, 0) {
    Some(value) => value
    None => fail("32x32 mask missing")
  }
  let subsampled = match av1_wedge_plane_mask(32, 32, 0, 0, 1, 0) {
    Some(value) => value
    None => fail("32x32 chroma mask missing")
  }
  assert_eq(subsampled.length(), 16 * 32)
  let mut mismatches = 0
  for i in 0..<32 {
    for j in 0..<16 {
      let sum = luma[i * 32 + 2 * j] + luma[i * 32 + 2 * j + 1]
      let m = (sum + 1) >> 1
      if subsampled[i * 16 + j] != m {
        mismatches = mismatches + 1
      }
    }
  }
  assert_eq(mismatches, 0)
  // 4:2:0 quarters a 2x2 group with the spec's rounding.
  let both = match av1_wedge_plane_mask(32, 32, 0, 0, 1, 1) {
    Some(value) => value
    None => fail("32x32 420 mask missing")
  }
  assert_eq(both.length(), 16 * 16)
  mismatches = 0
  for i in 0..<16 {
    for j in 0..<16 {
      let a = luma[(2 * i) * 32 + 2 * j]
      let b = luma[(2 * i) * 32 + 2 * j + 1]
      let c = luma[(2 * i + 1) * 32 + 2 * j]
      let d = luma[(2 * i + 1) * 32 + 2 * j + 1]
      if both[i * 16 + j] != ((a + b + c + d + 2) >> 2) {
        mismatches = mismatches + 1
      }
    }
  }
  assert_eq(mismatches, 0)
}

///|
/// Every wedge mask a stream can select, with `wedge_sign = 0` and the block's
/// own dimensions, as extracted from dav1d's generated table
/// (`dav1d_init_wedge_masks`, `src/wedge.c`). The nine sizes are the ones
/// `wedge_allowed_mask` and `Wedge_Bits` allow.
