    "0410040c2808e007e007d207e207d907d107f207d207dc0711081508c4071f082808e007e007d207e207d907de07e507d207dc0711081508c4071f08",
    "041f050c9c0811086f07a30871083708af0776076c08c7071d0807086308a0089c0811086f07a30871083708af0776076c08c7071d0807086308a008",
    "0420060c1d07b709a5084b088b062f0980065f070807e207f806cc081e0885081d07b709a5084b088b062f0980065f070807e207f806cc081e088508",
    "043f070c1f0984031207820abc0f190b950e030b3903a707570bb409030ebf041f0984031207820abc0f190b950e030b3903a707570bb409030ebf04",
  ])
  assert_eq(data.length() % 60, 0)
  for index in 0..<(data.length() / 60) {
    let start = index * 60
    let input = av1_loop_filter_reference_samples(data, start + 4)
    let saved = input.copy()
    let expected = av1_loop_filter_reference_samples(data, start + 32)
    let actual = av1_loop_filter_edge(
      input,
      data[start],
      data[start + 1],
      data[start + 2],
      data[start + 3],
    ).unwrap()
    assert_eq((index, actual), (index, expected))
    assert_eq(input, saved)
  }
}

