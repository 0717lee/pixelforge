    "040f030ad801090319009f037501b9006300b8013a008d0326005a0185022c01d801090319009f037501b9006300b8013a008d0326005a0185022c01",
    "0410040aff01f401f7010002fa01030208020702f401fe010502fe01fa010102ff01f401f7010002fa01030209020502f401fe010502fe01fa010102",
    "041f050a0e02f1010802d901e101ed010502e2012602d6011c021e02d701f7010e02f1010802d901e101ed010502e2012602d6011c021e02d701f701",
    "0420060ab601aa0150027702c6012c02ac011802b10125021a022b02af015902b601aa0150027702c6012c02ac011802b10125021a022b02af015902",
    "043f070a91017e0398027e03c3020203c5005a009a025f01a8035f032900b90191017e0398027e03c3020203c5005a009a025f01a8035f032900b901",
  ])
  assert_eq(data.length() % 60, 0)
  for index in 0..<(data.length() / 60) {
    let start = index * 60
    let input = av1_loop_filter_reference_samples(data, start + 4)
    let saved = input.copy()
    let expected = av1_loop_filter_reference_samples(data, start + 32)
    let actual = av1_loop_filter_edge(
      input,
      data[start],
      data[start + 1],
      data[start + 2],
      data[start + 3],
    ).unwrap()
    assert_eq((index, actual), (index, expected))
    assert_eq(input, saved)
  }
}

