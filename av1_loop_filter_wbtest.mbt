    "0e10040afc0101020c020202fc01fa01f401f001ff010302fe01fd01f301fb01fc0101020c020202fc01fa01f201f201ff010302fe01fd01f301fb01",
    "0e1f050a0102f60105020402f3010b021f022402120203022c022602fe01f8010102f60105020402f3010b021f022402120203022c022602fe01f801",
    "0e20060a8701ac016502c2014902ed011b02a401420248027b0254024a02db018701ac016502c2014902ed011b02a401420248027b0254024a02db01",
    "0e3f070af800f200ba03a3028103690355024301f403d40172014c02e3034000f800f200ba03a3028103690355024301f403d40172014c02e3034000",
  ])
  assert_eq(data.length() % 60, 0)
  for index in 0..<(data.length() / 60) {
    let start = index * 60
    let input = av1_loop_filter_reference_samples(data, start + 4)
    let saved = input.copy()
    let expected = av1_loop_filter_reference_samples(data, start + 32)
    let actual = av1_loop_filter_edge(
      input,
      data[start],
      data[start + 1],
      data[start + 2],
      data[start + 3],
    ).unwrap()
    assert_eq((index, actual), (index, expected))
    assert_eq(input, saved)
  }
}

