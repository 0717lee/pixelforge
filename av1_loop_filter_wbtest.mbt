    "080f03084c003e00ef000500c800af000900e200de00e500f3008100360055004c003e00ef000500c800af000900e200de00e500f300810036005500",
    "0810040880007e007d007d008200810082007d007e008000820080007e00800080007e007d007d008200800080007f007f008000820080007e008000",
    "081f050883007b00770075007c0076007a0082007a007f00810082008400850083007b00770075007c0076007a0082007a007f008100820084008500",
    "082006086c007a008c0064007c008e00940066006f006a009200750071008a006c007a008c0064007c008e00940066006f006a009200750071008a00",
    "083f070858005900460093009600bd005e0021009a003c00780006001500680058005900460093009600bd005e0021009a003c007800060015006800",
  ])
  assert_eq(data.length() % 60, 0)
  for index in 0..<(data.length() / 60) {
    let start = index * 60
    let input = av1_loop_filter_reference_samples(data, start + 4)
    let saved = input.copy()
    let expected = av1_loop_filter_reference_samples(data, start + 32)
    let actual = av1_loop_filter_edge(
      input,
      data[start],
      data[start + 1],
      data[start + 2],
      data[start + 3],
    ).unwrap()
    assert_eq((index, actual), (index, expected))
    assert_eq(input, saved)
  }
}

