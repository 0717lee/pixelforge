    "0e10040ce107e507fa07e607e007dc072b08cc071c08d507f407d007e807de07e107e507fa07e607e007dc07ff07f8071c08d507f407d007e807de07",
    "0e1f050c660710089f07e307dd0789077508c3070c086c08e0077608b3072708660710089f07e307dd0789077508c3070c086c08e0077608b3072708",
    "0e20060cec060509b8074509a306980922070e085c0887095e08c607be09e409ec060509b8074509a306980922070e085c0887095e08c607be09e409",
    "0e3f070c630ac30b570c83098208900a2a01b602e00c43082907cd0c8a02490f630ac30b570c83098208900a2a01b602e00c43082907cd0c8a02490f",
  ])
  assert_eq(data.length() % 60, 0)
  for index in 0..<(data.length() / 60) {
    let start = index * 60
    let input = av1_loop_filter_reference_samples(data, start + 4)
    let saved = input.copy()
    let expected = av1_loop_filter_reference_samples(data, start + 32)
    let actual = av1_loop_filter_edge(
      input,
      data[start],
      data[start + 1],
      data[start + 2],
      data[start + 3],
    ).unwrap()
    assert_eq((index, actual), (index, expected))
    assert_eq(input, saved)
  }
}

