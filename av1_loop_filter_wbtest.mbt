    "042000088100800083007d0083008300830083008000850084008500800084008100800083007d008300830083008300800085008400850080008400",
    "043f0108820077007c0081007500770082007c007f0081008700810081008600820077007c0081007500770082007c007f0081008700810081008600",
    "040102086b009a0084007600870085007900800085006a005e008d00680076006b009a0084007600870085007900800085006a005e008d0068007600",
    "040f030869007900eb0050009700490022008900de00640056008c000a00d50069007900eb0050009700490022008900de00640056008c000a00d500",
    "041004087f007d0080007d00820082007e0081007e007f0082007d00810082007f007d0080007d008200820080007f007e007f0082007d0081008200",
    "041f05088b007b007e0088007900850075007a007a0080007f008a00800081008b007b007e0088007900850075007a007a0080007f008a0080008100",
    "04200608980063008c006a008a0084007d0099008c00890087007c0077006e00980063008c006a008a0084007d0099008c00890087007c0077006e00",
    "043f0708d500a200430075009b005500a5005200e100f300bc004b0011003600d500a200430075009b005500a5005200e100f300bc004b0011003600",
  ])
  assert_eq(data.length() % 60, 0)
  for index in 0..<(data.length() / 60) {
    let start = index * 60
    let input = av1_loop_filter_reference_samples(data, start + 4)
    let saved = input.copy()
    let expected = av1_loop_filter_reference_samples(data, start + 32)
    let actual = av1_loop_filter_edge(
      input,
      data[start],
      data[start + 1],
      data[start + 2],
      data[start + 3],
    ).unwrap()
    assert_eq((index, actual), (index, expected))
    assert_eq(input, saved)
  }
}

