    "0e0102088800800084007b00680095008e00980075008d007c006d00670079008800800084007b00680095008e00980075008d007c006d0067007900",
    "0e0f0308a0006600f60093009200c90062006a005d00a8006000f000f9009300a0006600f60093009200c90062006a005d00a8006000f000f9009300",
    "0e10040883008100810082007d007d00810080007e007e007e007d008200800083008100810082007d007d00800080007e007e007e007d0082008000",
    "0e1f05087c007b007800800081007c0082007800800078008a008800780080007c007b007800800081007c0082007800800078008a00880078008000",
    "0e2006086d0083008c00960063009900950076006700960085008a00660071006d0083008c00960063009900950076006700960085008a0066007100",
    "0e3f07081b00e900c900c0000f00da00f1005700af00270012001c009b0034001b00e900c900c0000f00da00f1005700af00270012001c009b003400",
  ])
  assert_eq(data.length() % 60, 0)
  for index in 0..<(data.length() / 60) {
    let start = index * 60
    let input = av1_loop_filter_reference_samples(data, start + 4)
    let saved = input.copy()
    let expected = av1_loop_filter_reference_samples(data, start + 32)
    let actual = av1_loop_filter_edge(
      input,
      data[start],
      data[start + 1],
      data[start + 2],
      data[start + 3],
    ).unwrap()
    assert_eq((index, actual), (index, expected))
    assert_eq(input, saved)
  }
}

