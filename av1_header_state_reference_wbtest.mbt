    1, 174, 1, 177, 1, 179, 1, 168, 1, 170, 1, 181, 1, 184, 1, 187, 1, 175, 1, 177,
    1, 180, 1, 182, 1, 185, 1, 189, 1, 176, 1, 179, 1, 183, 1, 186, 1, 188, 1, 176,
    1, 178, 2, 181, 1, 168, 1, 171, 1, 174, 1, 177, 1, 179, 1, 167, 1, 169, 1, 172,
    1, 176, 1, 179, 1, 166, 1, 169, 1, 172, 1, 174, 1, 186, 1, 189, 1, 177, 1, 178,
    1, 182, 1, 186, 1, 187, 1, 175, 1, 177, 1, 181, 1, 184, 1, 187, 1, 174, 1, 177,
    1, 181, 1, 183, 1, 167, 1, 170, 1, 173, 1, 176, 1, 179, 1, 167, 1, 169, 1, 172,
    1, 175, 1, 178, 1, 181, 1, 168, 1, 171, 1, 174, 1, 177, 1, 180, 1, 176, 1, 178,
    1, 181, 1, 185, 1, 187, 1, 175, 1, 177, 1, 180, 1, 183, 1, 186, 1, 189, 1, 176,
    1, 179, 1, 182, 1, 185, 1, 188, 1, 172, 1, 175, 1, 177, 1, 182, 1, 168, 1, 171,
    1, 173, 1, 177, 1, 181, 1, 167, 1, 170, 1, 173, 1, 176, 1, 178, 1, 166, 1, 169,
    1, 180, 1, 183, 1, 186, 1, 189, 1, 177, 1, 179, 1, 182, 1, 185, 1, 189, 1, 176,
    1, 178, 1, 181, 1, 184, 1, 187, 1, 174, 1, 177, 1, 176, 1, 180, 1, 168, 1, 171,
    1, 173, 1, 176, 1, 179, 1, 165, 1, 169, 1, 172, 1, 175, 1, 178, 1, 180, 1, 168,
    1, 170, 1, 174, 1, 184, 1, 188, 1, 175, 1, 178, 1, 181, 1, 184, 1, 187, 1, 174,
    1, 177, 1, 180, 1, 183, 1, 186, 1, 188, 1, 176, 1, 179, 1, 182, 1,
  ])
  let map = av1_frame_map()
  let (_, frames) = av1_decode_obu_planes(stream, map, None, false).unwrap()
  assert_eq(frames.length(), 4)
  let mut offset = 0
  for frame in frames {
    assert_eq((frame.width, frame.height), (64, 64))
    for plane in 0..<3 {
      let samples = av1_frame_crop(frame, plane)
      for i in 0..<samples.length() {
        assert_eq(samples[i], expected[offset + i])
      }
      offset = offset + samples.length()
    }
  }
  assert_eq(offset, expected.length())
  assert_eq(map.current_frame_id, 0)
  assert_true(map.has_frame_id)
  assert_eq([map.frame_ids[0], map.frame_ids[1], map.frame_ids[2]], [6, 7, 0])
}

