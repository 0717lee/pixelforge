/// Generated by scripts/generate-av1-header-state-reference.py.

///|
fn av1_header_state_bytes(hex : String) -> Array[Byte] {
  let chars = hex.to_array()
  let nibble = fn(c : Char) {
    if c <= '9' {
      c.to_int() - 48
    } else {
      c.to_int() - 87
    }
  }
  Array::makei(chars.length() / 2, i => {
    (16 * nibble(chars[2 * i]) + nibble(chars[2 * i + 1])).to_byte()
  })
}

///|
fn av1_header_state_samples(pairs : Array[Int]) -> Array[Int] {
  let output : Array[Int] = []
  for i in 0..<(pairs.length() / 2) {
    for _ in 0..<pairs[i * 2 + 1] {
      output.push(pairs[i * 2])
    }
  }
  output
}

